diff --git a/MoltenVK/MoltenVK/Utility/MVKDeferredPSO.h b/MoltenVK/MoltenVK/Utility/MVKDeferredPSO.h
new file mode 100644
index 0000000..9037bd8
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKDeferredPSO.h
@@ -0,0 +1,142 @@
+/*
+ * MVKDeferredPSO.h — deferred Metal render pipeline compilation.
+ *
+ * RE Engine (and other D3D12 games) re-create their whole pipeline set (~48k for Pragmata) on background threads every
+ * launch. On Windows a driver-cache hit costs a few hundredths of a ms; through vkd3d -> MoltenVK -> Metal it cost ~16 ms
+ * per pipeline (~11 ms of it the Metal render pipeline compile), so the warm-up never finished and the game stalled for
+ * 1-3 s whenever it needed a pipeline still queued.
+ *
+ * Here vkCreateGraphicsPipelines does the CPU work (shader conversion, libraries, descriptor) and hands the Metal
+ * pipeline compile to this scheduler, which keeps only a few compiles in flight. The first draw that needs a pipeline
+ * that is still queued submits it immediately (ahead of the queue) and waits for it alone; while any draw is waiting,
+ * no new background compiles are submitted, and shader-library compiles on the game's threads pause (yieldToUrgent,
+ * at most 50 ms each), so Metal's compiler service works on the urgent ones first.
+ * MVK_DEFERRED_PSO=0 disables; MVK_DEFERRED_PSO_INFLIGHT sets the background concurrency (default 4).
+ */
+#pragma once
+
+#import <Metal/Metal.h>
+#include "MVKBaseObject.h"
+#include <mutex>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <vector>
+#include <chrono>
+#include <stdlib.h>
+
+struct MVKDeferredRenderPSO {
+	MTLRenderPipelineDescriptor* desc = nil;		// retained copy
+	id<MTLRenderPipelineState> state = nil;		// retained when done
+	std::mutex lock;
+	std::condition_variable done;
+	int status = 0;								// 0 queued, 1 submitted, 2 done (guarded: 0->1 by scheduler lock, 1->2 by lock)
+	~MVKDeferredRenderPSO() { [desc release]; [state release]; }
+};
+
+class MVKDeferredPSOScheduler {
+public:
+	static bool enabled() {
+		static const bool e = !(getenv("MVK_DEFERRED_PSO") && getenv("MVK_DEFERRED_PSO")[0] == '0');
+		return e;
+	}
+
+	static MVKDeferredPSOScheduler& get(id<MTLDevice> dev) {
+		static MVKDeferredPSOScheduler* s = new MVKDeferredPSOScheduler(dev);
+		return *s;
+	}
+
+	/** Queues a compile of a copy of the descriptor. */
+	std::shared_ptr<MVKDeferredRenderPSO> enqueue(MTLRenderPipelineDescriptor* desc) {
+		auto job = std::make_shared<MVKDeferredRenderPSO>();
+		job->desc = [desc copy];
+		std::vector<std::shared_ptr<MVKDeferredRenderPSO>> submit;
+		{
+			std::lock_guard<std::mutex> g(_lock);
+			_queue.push_back(job);
+			takeLocked(submit);
+		}
+		for (auto& j : submit) { submitJob(j); }
+		return job;
+	}
+
+	/**
+	 * Called before other Metal compiles (shader libraries, synchronous pipelines) on the game's threads: while a draw is
+	 * waiting on a pipeline, waits (at most maxWaitMs) so Metal's compiler service works on the urgent one first.
+	 */
+	void yieldToUrgent(int maxWaitMs = 50) {
+		std::unique_lock<std::mutex> g(_lock);
+		if (_waiting == 0) { return; }
+		_urgentClear.wait_for(g, std::chrono::milliseconds(maxWaitMs), [&] { return _waiting == 0; });
+	}
+
+	/** Returns the compiled state (retained +1 for the caller), compiling it now if it is still queued. */
+	id<MTLRenderPipelineState> wait(const std::shared_ptr<MVKDeferredRenderPSO>& job) {
+		bool urgent = false;
+		{
+			std::lock_guard<std::mutex> g(_lock);
+			if (job->status == 0) { job->status = 1; _inflight++; urgent = true; }
+			_waiting++;		// pauses background submissions until every waiting draw has its pipeline
+		}
+		if (urgent) { submitJob(job, /*alreadyMarked*/ true); }
+		{
+			std::unique_lock<std::mutex> lk(job->lock);
+			job->done.wait(lk, [&] { return job->status == 2; });
+		}
+		std::vector<std::shared_ptr<MVKDeferredRenderPSO>> resume;
+		{
+			std::lock_guard<std::mutex> g(_lock);
+			_waiting--;
+			takeLocked(resume);
+		}
+		_urgentClear.notify_all();
+		for (auto& j : resume) { submitJob(j); }
+		return [job->state retain];
+	}
+
+private:
+	MVKDeferredPSOScheduler(id<MTLDevice> dev) : _dev([dev retain]) {
+		if (const char* v = getenv("MVK_DEFERRED_PSO_INFLIGHT")) { _maxInflight = std::max(1, atoi(v)); }
+	}
+
+	void takeLocked(std::vector<std::shared_ptr<MVKDeferredRenderPSO>>& out) {
+		while (_waiting == 0 && _inflight < _maxInflight && !_queue.empty()) {
+			auto j = _queue.front().lock();
+			_queue.pop_front();
+			if ( !j || j->status != 0 ) { continue; }		// pipeline destroyed, or already submitted urgently
+			j->status = 1;
+			_inflight++;
+			out.push_back(j);
+		}
+	}
+
+	// Called without the scheduler lock held (Metal may run the completion handler on this thread).
+	void submitJob(std::shared_ptr<MVKDeferredRenderPSO> job, bool alreadyMarked = true) {
+		[_dev newRenderPipelineStateWithDescriptor: job->desc
+								 completionHandler: ^(id<MTLRenderPipelineState> ps, NSError* error) {
+			{
+				std::lock_guard<std::mutex> g(job->lock);
+				job->state = [ps retain];
+				job->status = 2;
+				[job->desc release];
+				job->desc = nil;
+			}
+			job->done.notify_all();
+			std::vector<std::shared_ptr<MVKDeferredRenderPSO>> next;
+			{
+				std::lock_guard<std::mutex> g(_lock);
+				_inflight--;
+				takeLocked(next);
+			}
+			for (auto& j : next) { submitJob(j); }
+		}];
+	}
+
+	id<MTLDevice> _dev;
+	std::mutex _lock;
+	std::deque<std::weak_ptr<MVKDeferredRenderPSO>> _queue;
+	int _inflight = 0;
+	int _waiting = 0;		// draws currently blocked on a pipeline
+	std::condition_variable _urgentClear;
+	int _maxInflight = 4;
+};
