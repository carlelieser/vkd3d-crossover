+// Metal requires a fragment function on mesh render pipelines, while Vulkan allows none.
+// Returns a cached empty fragment function to use in that case.
+static id<MTLFunction> getNullMeshFragmentFunction(id<MTLDevice> mtlDev) {
+	static id<MTLFunction> nullFrag = nil;
+	static dispatch_once_t once;
+	dispatch_once(&once, ^{
+		NSError* err = nil;
+		id<MTLLibrary> lib = [mtlDev newLibraryWithSource: @"#include <metal_stdlib>\nfragment void mvkNullMeshFragment() {}\n"
+		                                          options: nil
+		                                            error: &err];
+		nullFrag = [lib newFunctionWithName: @"mvkNullMeshFragment"];	// retained for process lifetime
+		[lib release];
+	});
+	return nullFrag;
+}
