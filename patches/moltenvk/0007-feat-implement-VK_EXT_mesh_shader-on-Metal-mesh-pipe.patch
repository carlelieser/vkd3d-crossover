+static void addCommonImplicitBuffersToShaderConfig(SPIRVToMSLConversionConfiguration& dst, const MVKOnePerEnumEntry<uint8_t, MVKImplicitBuffer>& src);
+static void setEmulatedReversedDepthViewportConfig(SPIRVToMSLConversionConfiguration& shaderConfig, const MVKOnePerEnumEntry<uint8_t, MVKImplicitBuffer>& implicit, bool enable);
+static void setDepthClipConfig(SPIRVToMSLConversionConfiguration& shaderConfig, const MVKOnePerEnumEntry<uint8_t, MVKImplicitBuffer>& implicit, bool enable);
+
+// SPIRV-Cross looks up resource bindings by the entry point's execution model. Mesh pipelines reuse the
+// tessellation stage slots, so duplicate those bindings under the task/mesh execution models.
+static void aliasTessBindingsForMeshStages(SPIRVToMSLConversionConfiguration& shaderConfig) {
+	auto remap = [](spv::ExecutionModel m) {
+		return m == spv::ExecutionModelTessellationControl ? spv::ExecutionModelTaskEXT :
+		       m == spv::ExecutionModelTessellationEvaluation ? spv::ExecutionModelMeshEXT : spv::ExecutionModelMax;
+	};
+	size_t rbCount = shaderConfig.resourceBindings.size();
+	for (size_t i = 0; i < rbCount; i++) {
+		auto to = remap(shaderConfig.resourceBindings[i].resourceBinding.stage);
+		if (to == spv::ExecutionModelMax) { continue; }
+		auto copy = shaderConfig.resourceBindings[i];
+		copy.resourceBinding.stage = to;
+		shaderConfig.resourceBindings.push_back(copy);
+	}
+	size_t dbCount = shaderConfig.dynamicBufferDescriptors.size();
+	for (size_t i = 0; i < dbCount; i++) {
+		auto to = remap(shaderConfig.dynamicBufferDescriptors[i].stage);
+		if (to == spv::ExecutionModelMax) { continue; }
+		auto copy = shaderConfig.dynamicBufferDescriptors[i];
+		copy.stage = to;
+		shaderConfig.dynamicBufferDescriptors.push_back(copy);
+	}
+}
