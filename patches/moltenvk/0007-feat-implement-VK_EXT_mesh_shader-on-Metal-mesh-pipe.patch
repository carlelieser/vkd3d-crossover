+// Returns a retained MTLMeshRenderPipelineDescriptor (as id) for a task/mesh pipeline, or nil on error.
+id MVKGraphicsPipeline::newMTLMeshRenderPipelineDescriptor(const VkGraphicsPipelineCreateInfo* pCreateInfo,
+                                                           const SPIRVTessReflectionData& reflectData,
+                                                           const VkPipelineShaderStageCreateInfo* pTaskSS,
+                                                           VkPipelineCreationFeedback* pTaskFB,
+                                                           const VkPipelineShaderStageCreateInfo* pMeshSS,
+                                                           VkPipelineCreationFeedback* pMeshFB,
+                                                           const VkPipelineShaderStageCreateInfo* pFragmentSS,
+                                                           VkPipelineCreationFeedback* pFragmentFB) {
+	if (@available(macOS 13.0, iOS 16.0, tvOS 16.0, *)) {
+		if ( !getPhysicalDevice()->supportsMeshShaders() ) {
+			setConfigurationResult(reportError(VK_ERROR_FEATURE_NOT_PRESENT, "This device does not support Metal mesh pipelines."));
+			return nil;
+		}
+
+		SPIRVToMSLConversionConfiguration shaderConfig;
+		initShaderConversionConfig(shaderConfig, pCreateInfo, reflectData);
+		aliasTessBindingsForMeshStages(shaderConfig);
+
+		MTLMeshRenderPipelineDescriptor* meshDesc = [MTLMeshRenderPipelineDescriptor new];	// retained
+
+		// Object (task) function
+		if (pTaskSS) {
+			const auto& implicit = _stageResources[kMVKShaderStageTessCtl].implicitBuffers.ids;
+			shaderConfig.options.entryPointStage = spv::ExecutionModelTaskEXT;
+			shaderConfig.options.entryPointName = pTaskSS->pName;
+			addCommonImplicitBuffersToShaderConfig(shaderConfig, implicit);
+			shaderConfig.options.mslOptions.capture_output_to_buffer = false;
+			setEmulatedReversedDepthViewportConfig(shaderConfig, implicit, false);
+			setDepthClipConfig(shaderConfig, implicit, false);
+			MVKMTLFunction func = getMTLFunction(shaderConfig, pTaskSS, pTaskFB, _tessCtlModule, "Task");
+			id<MTLFunction> mtlFunc = func.getMTLFunction();
+			if ( !mtlFunc ) { [meshDesc release]; return nil; }
+			meshDesc.objectFunction = mtlFunc;
+			_taskThreadgroupSize = func.threadGroupSize;
+			meshDesc.maxTotalThreadsPerObjectThreadgroup = _taskThreadgroupSize.width * _taskThreadgroupSize.height * _taskThreadgroupSize.depth;
+			meshDesc.payloadMemoryLength = 16384;
+			populateResourceUsage(_stageResources[kMVKShaderStageTessCtl], shaderConfig, func.shaderConversionResults, spv::ExecutionModelTaskEXT);
+			_layout->populateBindOperations(_stageResources[kMVKShaderStageTessCtl].bindScript, shaderConfig, spv::ExecutionModelTaskEXT);
+			if ( !verifyImplicitBuffers(kMVKShaderStageTessCtl) ) { [meshDesc release]; return nil; }
+		}
+
+		// Mesh function
+		SPIRVShaderOutputs meshOutputs;
+		{
+			std::string errorLog;
+			if ( !getShaderOutputs(_tessEvalModule->getSPIRV(), spv::ExecutionModelMeshEXT, pMeshSS->pName, meshOutputs, errorLog) ) {
+				setConfigurationResult(reportError(VK_ERROR_INITIALIZATION_FAILED, "Failed to get mesh shader outputs: %s", errorLog.c_str()));
+				[meshDesc release];
+				return nil;
+			}
+			const auto& implicit = _stageResources[kMVKShaderStageTessEval].implicitBuffers.ids;
+			shaderConfig.options.entryPointStage = spv::ExecutionModelMeshEXT;
+			shaderConfig.options.entryPointName = pMeshSS->pName;
+			addCommonImplicitBuffersToShaderConfig(shaderConfig, implicit);
+			shaderConfig.options.mslOptions.capture_output_to_buffer = false;
+			shaderConfig.options.mslOptions.disable_rasterization = !_isRasterizing;
+			setEmulatedReversedDepthViewportConfig(shaderConfig, implicit, false);
+			setDepthClipConfig(shaderConfig, implicit, false);
+			MVKMTLFunction func = getMTLFunction(shaderConfig, pMeshSS, pMeshFB, _tessEvalModule, "Mesh");
+			id<MTLFunction> mtlFunc = func.getMTLFunction();
+			if ( !mtlFunc ) { [meshDesc release]; return nil; }
+			meshDesc.meshFunction = mtlFunc;
+			_meshThreadgroupSize = func.threadGroupSize;
+			meshDesc.maxTotalThreadsPerMeshThreadgroup = _meshThreadgroupSize.width * _meshThreadgroupSize.height * _meshThreadgroupSize.depth;
+			populateResourceUsage(_stageResources[kMVKShaderStageTessEval], shaderConfig, func.shaderConversionResults, spv::ExecutionModelMeshEXT);
+			_layout->populateBindOperations(_stageResources[kMVKShaderStageTessEval].bindScript, shaderConfig, spv::ExecutionModelMeshEXT);
+			if ( !verifyImplicitBuffers(kMVKShaderStageTessEval) ) { [meshDesc release]; return nil; }
+		}
+
+		// Fragment function and outputs: reuse the regular render-pipeline code on a scratch
+		// descriptor, then copy the relevant state onto the mesh descriptor.
+		MTLRenderPipelineDescriptor* scratch = [MTLRenderPipelineDescriptor new];	// temp retain
+		bool ok = addFragmentShaderToPipeline(scratch, pCreateInfo, shaderConfig, meshOutputs, _isRasterizing ? pFragmentSS : nullptr, pFragmentFB);
+		if (ok) {
+			addFragmentOutputToPipeline(scratch, pCreateInfo);
+			meshDesc.fragmentFunction = scratch.fragmentFunction ? scratch.fragmentFunction : getNullMeshFragmentFunction(getMTLDevice());
+			for (uint32_t i = 0; i < kMVKMaxColorAttachmentCount; i++) {
+				meshDesc.colorAttachments[i] = scratch.colorAttachments[i];
+			}
+			meshDesc.depthAttachmentPixelFormat = scratch.depthAttachmentPixelFormat;
+			meshDesc.stencilAttachmentPixelFormat = scratch.stencilAttachmentPixelFormat;
+			meshDesc.rasterSampleCount = scratch.rasterSampleCount;
+			meshDesc.alphaToCoverageEnabled = scratch.alphaToCoverageEnabled;
+			meshDesc.alphaToOneEnabled = scratch.alphaToOneEnabled;
+			meshDesc.rasterizationEnabled = _isRasterizing;
+		}
+		[scratch release];	// temp release
+		if ( !ok ) { [meshDesc release]; return nil; }
+
+		setMetalObjectLabel(meshDesc, ((MVKPipelineLayout*)pCreateInfo->layout)->getDebugName());
+		return meshDesc;
+	}
+	setConfigurationResult(reportError(VK_ERROR_FEATURE_NOT_PRESENT, "Mesh pipelines require macOS 13 / iOS 16."));
+	return nil;
+}
