+id<MTLRenderPipelineState> MVKRenderPipelineCompiler::newMTLMeshRenderPipelineState(id mtlMeshRPLDesc) {
+	if (@available(macOS 13.0, iOS 16.0, tvOS 16.0, *)) {
+		unique_lock<mutex> lock(_completionLock);
