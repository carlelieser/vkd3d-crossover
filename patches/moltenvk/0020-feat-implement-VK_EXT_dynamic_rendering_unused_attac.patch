+id<MTLRenderPipelineState> MVKGraphicsPipeline::getPipelineStateForAttachments(const MTLPixelFormat* color,
+																			   MTLPixelFormat depth,
+																			   MTLPixelFormat stencil) {
+	bool same = depth == _plDepthFormat && stencil == _plStencilFormat;
+	for (uint32_t i = 0; same && i < 8; i++) { same = color[i] == _plColorFormats[i]; }
+	if (same || !_variantBaseDesc) { return getMainPipelineState(); }
+
+	// Only presence may differ (an attachment unused by the pipeline, or a pipeline output with nothing bound).
+	// Different real formats in the same slot are not allowed by Vulkan; keep the main state for those.
+	for (uint32_t i = 0; i < 8; i++) {
+		if (color[i] && _plColorFormats[i] && color[i] != _plColorFormats[i]) { return getMainPipelineState(); }
+	}
+	if ((depth && _plDepthFormat && depth != _plDepthFormat) || (stencil && _plStencilFormat && stencil != _plStencilFormat)) {
+		return getMainPipelineState();
+	}
+
+	std::string key((const char*)color, sizeof(MTLPixelFormat) * 8);
+	key.append((const char*)&depth, sizeof(depth));
+	key.append((const char*)&stencil, sizeof(stencil));
+
+	std::lock_guard<std::mutex> lock(_attachmentVariantLock);
+	auto it = _attachmentVariants.find(key);
+	if (it != _attachmentVariants.end()) { return it->second ? it->second : getMainPipelineState(); }
+
+	id<MTLRenderPipelineState> variant = nil;
+	@autoreleasepool {
+		MTLRenderPipelineDescriptor* desc = [[_variantBaseDesc copy] autorelease];
+		for (uint32_t i = 0; i < 8; i++) {
+			MTLRenderPipelineColorAttachmentDescriptor* ca = desc.colorAttachments[i];
+			if (color[i] == _plColorFormats[i]) { continue; }
+			// Bound but unused by the pipeline: match the format, write nothing.
+			// Pipeline output with nothing bound: no attachment, writes discarded.
+			ca.pixelFormat = color[i];
+			ca.blendingEnabled = NO;
+			ca.writeMask = MTLColorWriteMaskNone;
+		}
+		desc.depthAttachmentPixelFormat = depth;
+		desc.stencilAttachmentPixelFormat = stencil;
+		// Compile directly (silently): a shader that writes depth / stencil ref cannot drop those formats,
+		// so on failure retry keeping the pipeline's own depth/stencil formats.
+		NSError* err = nil;
+		if ( !variant ) { variant = [getMTLDevice() newRenderPipelineStateWithDescriptor: desc error: &err]; }	// retained
+		if ( !variant && (depth != _plDepthFormat || stencil != _plStencilFormat) ) {
+			desc.depthAttachmentPixelFormat = depth ? depth : _plDepthFormat;
+			desc.stencilAttachmentPixelFormat = stencil ? stencil : _plStencilFormat;
+			err = nil;
+			variant = [getMTLDevice() newRenderPipelineStateWithDescriptor: desc error: &err];	// retained
+		}
+	}
+	_attachmentVariants[key] = variant;
+	return variant ? variant : getMainPipelineState();
+}
