diff --git a/MoltenVK/MoltenVK/Commands/MVKCommandEncoderState.mm b/MoltenVK/MoltenVK/Commands/MVKCommandEncoderState.mm
index 02fa230..7e5d77a 100644
--- a/MoltenVK/MoltenVK/Commands/MVKCommandEncoderState.mm
+++ b/MoltenVK/MoltenVK/Commands/MVKCommandEncoderState.mm
@@ -1482,6 +1482,20 @@ void MVKMetalGraphicsCommandEncoderState::prepareDraw(
 		const MVKRenderSubpass* subpass = mvkEncoder.getSubpass();
 		if (subpass->isMultiview() && !pipeline->isTessellationPipeline() && !pipeline->isMeshPipeline()) {
 			mtlPipeline = pipeline->getMultiviewPipelineState(subpass->getViewCountInMetalPass(mvkEncoder.getMultiviewPassIndex()));
+		} else if (!pipeline->isTessellationPipeline() && !pipeline->isMeshPipeline()) {
+			// Match the pipeline's attachment formats to what is actually bound (unused/null attachments).
+			MVKPixelFormats* pixFmts = mvkEncoder.getPixelFormats();
+			MTLPixelFormat color[8] = {};
+			MVKRenderSubpass* sp = const_cast<MVKRenderSubpass*>(subpass);	// accessors are non-const but side-effect free
+			uint32_t caCnt = std::min(sp->getColorAttachmentCount(), 8u);
+			for (uint32_t i = 0; i < caCnt; i++) {
+				if (sp->isColorAttachmentUsed(i)) { color[i] = pixFmts->getMTLPixelFormat(sp->getColorAttachmentFormat(i)); }
+			}
+			MTLPixelFormat depth = pixFmts->getMTLPixelFormat(sp->getDepthFormat());
+			MTLPixelFormat stencil = pixFmts->getMTLPixelFormat(sp->getStencilFormat());
+			if ( !pixFmts->isDepthFormat(depth) ) { depth = MTLPixelFormatInvalid; }
+			if ( !pixFmts->isStencilFormat(stencil) ) { stencil = MTLPixelFormatInvalid; }
+			mtlPipeline = pipeline->getPipelineStateForAttachments(color, depth, stencil);
 		} else {
 			mtlPipeline = pipeline->getMainPipelineState();
 		}
