+// Metal has no indirect-count draws; MoltenVK converts each one with a compute dispatch. Done at the draw, that
+// splits the render pass (store + reload of every attachment), which on tile-based GPUs costs more than the draw.
+// Instead, before a render pass starts, convert every indirect-count draw recorded in it. Inside a Vulkan render
+// pass the indirect and count buffers can only change through shader writes, which GPU-driven renderers don't do to
+// their own draw arguments. MVK_HOIST_INDIRECT_COUNT=0 restores the per-draw path.
+void MVKCommandEncoder::hoistIndirectCountConversions(MVKCommand* fromCmd) {
+	static const bool enabled = !(getenv("MVK_HOIST_INDIRECT_COUNT") && getenv("MVK_HOIST_INDIRECT_COUNT")[0] == '0');
+	_hoistedIndirectCount.clear();
+	if ( !enabled || !fromCmd ) { return; }
+	for (MVKCommand* cmd = fromCmd->_next; cmd; cmd = cmd->_next) {
+		if (dynamic_cast<MVKCmdEndRendering*>(cmd) || dynamic_cast<MVKCmdEndRenderPass*>(cmd) ||
+			dynamic_cast<MVKCmdNextSubpass*>(cmd) ||
+			dynamic_cast<MVKCmdBeginRenderPassBase*>(cmd)) { break; }
+		if (auto* d = dynamic_cast<MVKCmdDrawIndexedIndirect*>(cmd)) { d->hoistCountConversion(this); }
+		else if (auto* d = dynamic_cast<MVKCmdDrawIndirect*>(cmd)) { d->hoistCountConversion(this); }
+	}
+}
+
 void MVKCommandEncoder::beginRendering(MVKCommand* rendCmd, const VkRenderingInfo* pRenderingInfo) {
+	hoistIndirectCountConversions(_currentEncodingCmd == rendCmd ? rendCmd : nullptr);
 
 	VkSubpassContents contents = (mvkIsAnyFlagEnabled(pRenderingInfo->flags, VK_RENDERING_CONTENTS_SECONDARY_COMMAND_BUFFERS_BIT)
 								  ? VK_SUBPASS_CONTENTS_SECONDARY_COMMAND_BUFFERS
@@ -544,6 +565,7 @@ void MVKCommandEncoder::beginRenderpass(MVKCommand* passCmd,
 										MVKArrayRef<VkClearValue> clearValues,
