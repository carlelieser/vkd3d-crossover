 }
 
+void MVKCmdDrawIndirect::hoistCountConversion(MVKCommandEncoder* cmdEncoder) {
+	if ( !_mtlCountBuffer || _drawCount == 0 ) { return; }
+	cmdEncoder->_hoistedIndirectCount[this] = encodeIndirectCountConversionHoisted(cmdEncoder, _mtlIndirectBuffer,
+			_mtlIndirectBufferOffset, _mtlIndirectBufferStride, _mtlCountBuffer, _mtlCountBufferOffset, _drawCount, false);
+}
