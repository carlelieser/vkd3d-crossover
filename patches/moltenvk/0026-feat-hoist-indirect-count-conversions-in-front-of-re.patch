 void MVKCmdDrawIndirect::encode(MVKCommandEncoder* cmdEncoder) {
 
 	cmdEncoder->restartMetalRenderPassIfNeeded();
@@ -881,7 +919,9 @@ void MVKCmdDrawIndirect::encode(MVKCommandEncoder* cmdEncoder) {
 	uint32_t indirectBufferStride = _mtlIndirectBufferStride;
 
 	if (_mtlCountBuffer && _drawCount > 0) {
-		auto* convertedBuffer = encodeIndirectCountConversion(cmdEncoder,
+		auto hoisted = cmdEncoder->_hoistedIndirectCount.find(this);
+		auto* convertedBuffer = hoisted != cmdEncoder->_hoistedIndirectCount.end() ? hoisted->second :
+			encodeIndirectCountConversion(cmdEncoder,
 				indirectBuffer,
 				indirectBufferOffset,
 				indirectBufferStride,
@@ -1222,6 +1262,12 @@ VkResult MVKCmdDrawIndexedIndirect::setContent(MVKCommandBuffer* cmdBuff,
 	return VK_SUCCESS;
 }
 
+void MVKCmdDrawIndexedIndirect::hoistCountConversion(MVKCommandEncoder* cmdEncoder) {
+	if ( !_mtlCountBuffer || _drawCount == 0 ) { return; }
+	cmdEncoder->_hoistedIndirectCount[this] = encodeIndirectCountConversionHoisted(cmdEncoder, _mtlIndirectBuffer,
+			_mtlIndirectBufferOffset, _mtlIndirectBufferStride, _mtlCountBuffer, _mtlCountBufferOffset, _drawCount, true);
+}
