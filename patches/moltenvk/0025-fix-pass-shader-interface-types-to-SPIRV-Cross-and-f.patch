@@ -1320,6 +1336,67 @@ static void addCommonImplicitBuffersToShaderConfig(SPIRVToMSLConversionConfigura
 static void setEmulatedReversedDepthViewportConfig(SPIRVToMSLConversionConfiguration& shaderConfig, const MVKOnePerEnumEntry<uint8_t, MVKImplicitBuffer>& implicit, bool enable);
 static void setDepthClipConfig(SPIRVToMSLConversionConfiguration& shaderConfig, const MVKOnePerEnumEntry<uint8_t, MVKImplicitBuffer>& implicit, bool enable);
 
+// Vulkan/D3D12 allow a vertex attribute's format type class (float vs signed vs unsigned integer) to differ
+// from the shader input's type (values are then undefined), but Metal rejects such pipelines. Remap the Metal
+// vertex format to one of the same size and component count in the shader's type class.
+// typeClass: 0 = float, 1 = signed int, 2 = unsigned int.
+static MTLVertexFormat mvkVertexFormatForShaderTypeClass(MTLVertexFormat f, uint8_t typeClass) {
+	struct Row { MTLVertexFormat flt, sint, uint; };
+	static const Row rows[] = {
+		// 32-bit components: bit reinterpretation.
+		{ MTLVertexFormatFloat,  MTLVertexFormatInt,  MTLVertexFormatUInt },
+		{ MTLVertexFormatFloat2, MTLVertexFormatInt2, MTLVertexFormatUInt2 },
+		{ MTLVertexFormatFloat3, MTLVertexFormatInt3, MTLVertexFormatUInt3 },
+		{ MTLVertexFormatFloat4, MTLVertexFormatInt4, MTLVertexFormatUInt4 },
+		// 16-bit components.
+		{ MTLVertexFormatHalf,  MTLVertexFormatShort,  MTLVertexFormatUShort },
+		{ MTLVertexFormatHalf2, MTLVertexFormatShort2, MTLVertexFormatUShort2 },
+		{ MTLVertexFormatHalf3, MTLVertexFormatShort3, MTLVertexFormatUShort3 },
+		{ MTLVertexFormatHalf4, MTLVertexFormatShort4, MTLVertexFormatUShort4 },
+	};
+	struct NormRow { MTLVertexFormat sNorm, uNorm, sint, uint; };
+	static const NormRow normRows[] = {
+		{ MTLVertexFormatCharNormalized,   MTLVertexFormatUCharNormalized,   MTLVertexFormatChar,   MTLVertexFormatUChar },
+		{ MTLVertexFormatChar2Normalized,  MTLVertexFormatUChar2Normalized,  MTLVertexFormatChar2,  MTLVertexFormatUChar2 },
+		{ MTLVertexFormatChar3Normalized,  MTLVertexFormatUChar3Normalized,  MTLVertexFormatChar3,  MTLVertexFormatUChar3 },
+		{ MTLVertexFormatChar4Normalized,  MTLVertexFormatUChar4Normalized,  MTLVertexFormatChar4,  MTLVertexFormatUChar4 },
+		{ MTLVertexFormatShortNormalized,  MTLVertexFormatUShortNormalized,  MTLVertexFormatShort,  MTLVertexFormatUShort },
+		{ MTLVertexFormatShort2Normalized, MTLVertexFormatUShort2Normalized, MTLVertexFormatShort2, MTLVertexFormatUShort2 },
+		{ MTLVertexFormatShort3Normalized, MTLVertexFormatUShort3Normalized, MTLVertexFormatShort3, MTLVertexFormatUShort3 },
+		{ MTLVertexFormatShort4Normalized, MTLVertexFormatUShort4Normalized, MTLVertexFormatShort4, MTLVertexFormatUShort4 },
+	};
+	for (auto& r : rows) {
+		if (f == r.flt || f == r.sint || f == r.uint) {
+			return typeClass == 0 ? r.flt : (typeClass == 1 ? r.sint : r.uint);
+		}
+	}
+	for (auto& r : normRows) {
+		bool isInt = (f == r.sint || f == r.uint);
+		bool isNorm = (f == r.sNorm || f == r.uNorm);
+		if (!isInt && !isNorm) { continue; }
+		bool isSigned = (f == r.sint || f == r.sNorm);
+		if (typeClass == 0) { return isNorm ? f : (isSigned ? r.sNorm : r.uNorm); }	// int -> normalized float
+		if (typeClass == 1) { return isSigned ? r.sint : r.sint; }
+		return r.uint;
+	}
+	return f;
+}
+
+static uint8_t mvkVertexFormatTypeClass(MTLVertexFormat f) {
+	switch (f) {
+		case MTLVertexFormatInt: case MTLVertexFormatInt2: case MTLVertexFormatInt3: case MTLVertexFormatInt4:
+		case MTLVertexFormatShort: case MTLVertexFormatShort2: case MTLVertexFormatShort3: case MTLVertexFormatShort4:
+		case MTLVertexFormatChar: case MTLVertexFormatChar2: case MTLVertexFormatChar3: case MTLVertexFormatChar4:
+			return 1;
+		case MTLVertexFormatUInt: case MTLVertexFormatUInt2: case MTLVertexFormatUInt3: case MTLVertexFormatUInt4:
+		case MTLVertexFormatUShort: case MTLVertexFormatUShort2: case MTLVertexFormatUShort3: case MTLVertexFormatUShort4:
+		case MTLVertexFormatUChar: case MTLVertexFormatUChar2: case MTLVertexFormatUChar3: case MTLVertexFormatUChar4:
+			return 2;
+		default:
+			return 0;
+	}
+}
