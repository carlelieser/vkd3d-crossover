 static void aliasTessBindingsForMeshStages(SPIRVToMSLConversionConfiguration& shaderConfig) {
@@ -1880,6 +1957,28 @@ bool MVKGraphicsPipeline::addFragmentShaderToPipeline(MTLRenderPipelineDescripto
 	auto& mtlFeats = getMetalFeatures();
 	if (pFragmentSS) {
 		shaderConfig.options.entryPointStage = spv::ExecutionModelFragment;
+		// Tell SPIRV-Cross each color attachment's base type, so outputs whose type doesn't match
+		// (legal in Vulkan/D3D12, rejected by Metal) are retyped and bit-cast instead of failing the pipeline.
+		mvkClear(shaderConfig.options.mslOptions.fragment_output_basetypes, 8);
+		if (const VkPipelineRenderingCreateInfo* pRendInfo = getRenderingCreateInfo(pCreateInfo)) {
+			for (uint32_t caIdx = 0; caIdx < pRendInfo->colorAttachmentCount && caIdx < 8; caIdx++) {
+				VkFormat fmt = pRendInfo->pColorAttachmentFormats ? pRendInfo->pColorAttachmentFormats[caIdx] : VK_FORMAT_UNDEFINED;
+				if (fmt == VK_FORMAT_UNDEFINED) { continue; }
+				uint8_t bt = 0;
+				switch (getPixelFormats()->getFormatType(fmt)) {
+					case kMVKFormatColorHalf:
+					case kMVKFormatColorFloat:   bt = 1; break;
+					case kMVKFormatColorInt8:
+					case kMVKFormatColorInt16:
+					case kMVKFormatColorInt32:   bt = 2; break;
+					case kMVKFormatColorUInt8:
+					case kMVKFormatColorUInt16:
+					case kMVKFormatColorUInt32:  bt = 3; break;
+					default: break;
+				}
+				shaderConfig.options.mslOptions.fragment_output_basetypes[caIdx] = bt;
+			}
+		}
 		addCommonImplicitBuffersToShaderConfig(shaderConfig, implicit);
 		shaderConfig.options.mslOptions.view_mask_buffer_index = implicit[MVKImplicitBuffer::ViewRange];
 		shaderConfig.options.entryPointName = pFragmentSS->pName;
@@ -2055,6 +2154,10 @@ bool MVKGraphicsPipeline::addVertexInputToPipeline(T* inputDesc,
 				}
 			}
 
+			auto tcIt = _vertexInputTypeClass.find(pVKVA->location);
+			if (tcIt != _vertexInputTypeClass.end() && mvkVertexFormatTypeClass((MTLVertexFormat)mtlFormat) != tcIt->second) {
+				mtlFormat = (decltype(vaDesc.format))mvkVertexFormatForShaderTypeClass((MTLVertexFormat)mtlFormat, tcIt->second);
+			}
 			vaDesc.format = mtlFormat;
 			vaDesc.bufferIndex = (decltype(vaDesc.bufferIndex))getMetalBufferIndexForVertexAttributeBinding(vaBinding);
 			vaDesc.offset = vaOffset;
@@ -2528,12 +2631,24 @@ void MVKGraphicsPipeline::addNextStageInputToShaderConversionConfig(SPIRVToMSLCo
 void MVKGraphicsPipeline::addPrevStageOutputToShaderConversionConfig(SPIRVToMSLConversionConfiguration& shaderConfig,
                                                                      SPIRVShaderOutputs& shaderOutputs) {
     shaderConfig.shaderInputs.clear();
+	// Record the previous stage's 32-bit output base types per location, so SPIRV-Cross can bit-cast fragment
+	// inputs whose type differs (legal in Vulkan/D3D12, rejected by Metal at pipeline creation).
+	mvkClear(shaderConfig.options.mslOptions.fragment_input_basetypes, 32);
 
 	mvk::MSLShaderInput si;
 	auto& sisv = si.shaderVar;
 	for (auto& so : shaderOutputs) {
 		if ( !so.isUsed ) { continue; }
 
+		if (so.builtin == spv::BuiltInMax && so.location < 32) {
+			// Only describe locations written by a single, unpacked output. Component-packed locations can mix types.
+			uint32_t sharers = 0;
+			for (auto& o2 : shaderOutputs) { if (o2.isUsed && o2.builtin == spv::BuiltInMax && o2.location == so.location) { sharers++; } }
+			using BT = SPIRV_CROSS_NAMESPACE::SPIRType;
+			uint8_t bt = so.baseType == BT::Float ? 1 : so.baseType == BT::Int ? 2 : so.baseType == BT::UInt ? 3 : 0;
+			shaderConfig.options.mslOptions.fragment_input_basetypes[so.location] = (sharers == 1 && so.component == 0) ? bt : 0;
+		}
+
         sisv.location = so.location;
 		sisv.component = so.component;
         sisv.builtin = so.builtin;
@@ -2544,6 +2659,7 @@ void MVKGraphicsPipeline::addPrevStageOutputToShaderConversionConfig(SPIRVToMSLC
 
         shaderConfig.shaderInputs.push_back(si);
     }
+
 }
 
