+				using BT = SPIRV_CROSS_NAMESPACE::SPIRType;
+				uint8_t tc = (in.baseType == BT::Int || in.baseType == BT::Short || in.baseType == BT::SByte || in.baseType == BT::Int64) ? 1 :
