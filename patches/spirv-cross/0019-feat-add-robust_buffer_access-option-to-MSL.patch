+	if (ptr_type.storage != StorageClassImage)
+		if (auto *robust_guard = get_robust_buffer_guard(obj))
+			guard_cond = guard_cond.empty() ? *robust_guard : join(guard_cond, " && ", *robust_guard);
+	check_discard = !guard_cond.empty();
+
 	// Even compare exchange atomics are vec4 on metal for ... reasons :v
 	uint32_t vec4_temporary_id = 0;
 	if (use_native_image_atomic && is_atomic_compare_exchange_strong)
@@ -12369,11 +12507,11 @@ void CompilerMSL::emit_atomic_func_op(uint32_t result_type, uint32_t result_id,
 			emit_uninitialized_temporary_expression(result_type, result_id);
 			if (vec4_temporary_id)
 				emit_uninitialized_temporary_expression(vec4_temporary_id + 1, vec4_temporary_id);
-			statement("if (!", builtin_to_glsl(BuiltInHelperInvocation, StorageClassInput), ")");
+			statement("if (", guard_cond, ")");
 			begin_scope();
 		}
 		else
-			exp = join("(!", builtin_to_glsl(BuiltInHelperInvocation, StorageClassInput), " ? ");
+			exp = join("((", guard_cond, ") ? ");
 	}
 
 	if (use_native_image_atomic)
@@ -12632,12 +12770,20 @@ void CompilerMSL::emit_atomic64_emulated(uint32_t result_type, uint32_t result_i
 	}
 
 	string call = join(func, "(", args, ")");
+	auto *robust_guard = get_robust_buffer_guard(obj);
 	if (opcode == OpAtomicStore)
-		statement(call, ";");
+	{
+		if (robust_guard)
+			statement("if (", *robust_guard, ") ", call, ";");
+		else
+			statement(call, ";");
+	}
 	else
 	{
 		auto &res_type = get<SPIRType>(result_type);
 		string value = join("as_type<", type_to_glsl(res_type), ">(", call, ")");
+		if (robust_guard)
+			value = join("((", *robust_guard, ") ? ", value, " : ", type_to_glsl(res_type), "{})");
 		emit_op(result_type, result_id, value, false);
 	}
 
@@ -16599,7 +16745,8 @@ void CompilerMSL::fix_up_shader_inputs_outputs()
 				});
 			}
 		}
-		else if ((var.storage == StorageClassStorageBuffer || (var.storage == StorageClassUniform && ssbo)) &&
+		else if ((var.storage == StorageClassStorageBuffer || (var.storage == StorageClassUniform && ssbo) ||
+		          is_robust_buffer_variable(var)) &&
 		         !is_hidden_variable(var))
 		{
 			if (buffer_requires_array_length(var.self))
@@ -20371,6 +20518,13 @@ bool CompilerMSL::OpCodePreprocessor::handle(Op opcode, const uint32_t *args, ui
 		set<SPIRExpression>(id, "", result_type, true);
 		self.register_read(id, ptr, true);
 		self.ir.ids[id].set_allow_type_rewrite();
+
+		if (self.msl_options.robust_buffer_access && opcode != OpPtrAccessChain)
+		{
+			auto *var = self.maybe_get_backing_variable(ptr);
+			if (var && self.is_robust_buffer_variable(*var))
+				self.buffers_requiring_array_length.insert(var->self);
+		}
 		break;
 	}
 
