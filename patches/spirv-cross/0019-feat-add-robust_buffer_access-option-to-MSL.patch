                                       bool op1_is_pointer, bool op1_is_literal, uint32_t op2)
@@ -12344,6 +12473,15 @@ void CompilerMSL::emit_atomic_func_op(uint32_t result_type, uint32_t result_id,
 	bool check_discard = opcode != OpAtomicLoad && needs_frag_discard_checks() &&
 	                     ptr_type.storage != StorageClassWorkgroup;
 
+	// The helper-invocation check and the robust-buffer bounds check share one guard.
+	string guard_cond;
+	if (check_discard)
