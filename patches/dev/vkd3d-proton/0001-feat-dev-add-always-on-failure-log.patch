+/* Failure log. */
+struct vkd3d_failure_entry
+{
+    uint32_t hash;
+    uint32_t count;
+    uint32_t reported;
+    char key[160];
+};
+
+#define VKD3D_FAILURE_ENTRIES 1024
+static struct vkd3d_failure_entry *vkd3d_failure_entries;
+static pthread_once_t vkd3d_failure_once = PTHREAD_ONCE_INIT;
+static spinlock_t vkd3d_failure_spin;
+static uint64_t vkd3d_failure_last_summary_ns;
+#ifdef _WIN32
+static HANDLE vkd3d_failure_file = INVALID_HANDLE_VALUE;
+#else
+static FILE *vkd3d_failure_file;
+#endif
+
+static void vkd3d_failure_write(const char *str, size_t len)
+{
+#ifdef _WIN32
+    DWORD written;
+    if (vkd3d_failure_file != INVALID_HANDLE_VALUE)
+        WriteFile(vkd3d_failure_file, str, (DWORD)len, &written, NULL);
+#else
+    if (vkd3d_failure_file)
+    {
+        fwrite(str, 1, len, vkd3d_failure_file);
+        fflush(vkd3d_failure_file);
+    }
+#endif
+}
+
+static void vkd3d_failure_writef(const char *category, const char *fmt, ...) VKD3D_PRINTF_FUNC(2, 3);
+
+static void vkd3d_failure_write_line(const char *category, const char *msg, uint32_t occurrence)
+{
+    char line[2048];
+    size_t len = 0;
+    int lines = 0;
+    const char *p;
+#ifdef _WIN32
+    SYSTEMTIME st;
+    char exe[MAX_PATH] = "?";
+    const char *exe_name;
+    GetLocalTime(&st);
+    GetModuleFileNameA(NULL, exe, sizeof(exe));
+    exe_name = strrchr(exe, '\\') ? strrchr(exe, '\\') + 1 : exe;
+    len = snprintf(line, sizeof(line), "%02u:%02u:%02u.%03u vkd3d[%s:%04lx] %s: ", st.wHour, st.wMinute, st.wSecond,
+            st.wMilliseconds, exe_name, (unsigned long)GetCurrentProcessId(), category);
+#else
+    len = snprintf(line, sizeof(line), "vkd3d %s: ", category);
+#endif
+    if (occurrence > 1 && len < sizeof(line))
+        len += snprintf(line + len, sizeof(line) - len, "[#%u] ", occurrence);
+    for (p = msg; *p && len + 8 < sizeof(line); p++)
+    {
+        if (*p == '\n')
+        {
+            if (!p[1])
+                break;
+            if (++lines >= 8)
+                break;
+            memcpy(line + len, "\n    ", 5);
+            len += 5;
+            continue;
+        }
+        line[len++] = *p;
+    }
+    line[len++] = '\n';
+    vkd3d_failure_write(line, len);
+}
+
+static void vkd3d_failure_writef(const char *category, const char *fmt, ...)
+{
+    char msg[512];
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(msg, sizeof(msg), fmt, args);
+    va_end(args);
+    vkd3d_failure_write_line(category, msg, 1);
+}
+
+static void vkd3d_failure_init_once(void)
+{
+    char path[MAX_PATH];
+
+    if (vkd3d_get_env_var("VKD3D_FAILURE_LOG", path, sizeof(path)))
+    {
+        if (!strcmp(path, "0") || !strcmp(path, "off"))
+            return;
+    }
+    else
+    {
+        strcpy(path, "C:\\gfx-failures.log");
+    }
+#ifdef _WIN32
+    vkd3d_failure_file = CreateFileA(path, FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+            NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (vkd3d_failure_file == INVALID_HANDLE_VALUE)
+        return;
+#else
+    if (!(vkd3d_failure_file = fopen(path, "a")))
+        return;
+#endif
+    vkd3d_failure_entries = calloc(VKD3D_FAILURE_ENTRIES, sizeof(*vkd3d_failure_entries));
+    vkd3d_failure_last_summary_ns = vkd3d_get_current_time_ns();
+    vkd3d_failure_writef("process", "vkd3d-proton loaded");
+}
+
+bool vkd3d_failure_log_enabled(void)
+{
+    pthread_once(&vkd3d_failure_once, vkd3d_failure_init_once);
+    return vkd3d_failure_entries != NULL;
+}
+
+/* Collapses numbers and hex so failures that differ only in handles or sizes share one entry. */
+static uint32_t vkd3d_failure_make_key(const char *category, const char *msg, char *key, size_t key_size)
+{
+    uint32_t hash = 2166136261u;
+    size_t len = 0;
+    const char *p;
+
+    for (p = category; *p && len + 2 < key_size; p++)
+        key[len++] = *p;
+    key[len++] = ':';
+    for (p = msg; *p && *p != '\n' && len + 1 < key_size; p++)
+    {
+        if (p[0] == '0' && p[1] == 'x')
+        {
+            key[len++] = '#';
+            p += 2;
+            while (isxdigit((unsigned char)*p))
+                p++;
+            p--;
+            continue;
+        }
+        if (isdigit((unsigned char)*p))
+        {
+            key[len++] = '#';
+            while (isdigit((unsigned char)p[1]))
+                p++;
+            continue;
+        }
+        key[len++] = *p;
+    }
+    key[len] = '\0';
+    for (p = key; *p; p++)
+        hash = (hash ^ (uint8_t)*p) * 16777619u;
+    return hash;
+}
+
+static void vkd3d_failure_log_message(const char *category, const char *msg)
+{
+    struct vkd3d_failure_entry *entry = NULL;
+    char key[160];
+    uint32_t hash, i, occurrence;
+    uint64_t now;
+
+    if (!vkd3d_failure_log_enabled())
+        return;
+
+    hash = vkd3d_failure_make_key(category, msg, key, sizeof(key));
+
+    spinlock_acquire(&vkd3d_failure_spin);
+    for (i = 0; i < VKD3D_FAILURE_ENTRIES; i++)
+    {
+        struct vkd3d_failure_entry *e = &vkd3d_failure_entries[(hash + i) % VKD3D_FAILURE_ENTRIES];
+        if (!e->count)
+        {
+            e->hash = hash;
+            strcpy(e->key, key);
+            entry = e;
+            break;
+        }
+        if (e->hash == hash && !strcmp(e->key, key))
+        {
+            entry = e;
+            break;
+        }
+    }
+    occurrence = entry ? ++entry->count : 1;
+    if (entry && occurrence <= 3)
+        entry->reported = occurrence;
+
+    now = vkd3d_get_current_time_ns();
+    if (now - vkd3d_failure_last_summary_ns > 10000000000ull)
+    {
+        vkd3d_failure_last_summary_ns = now;
+        for (i = 0; i < VKD3D_FAILURE_ENTRIES; i++)
+        {
+            struct vkd3d_failure_entry *e = &vkd3d_failure_entries[i];
+            if (e->count > e->reported)
+            {
+                vkd3d_failure_writef("repeat", "+%u more: %s", e->count - e->reported, e->key);
+                e->reported = e->count;
+            }
+        }
+    }
+    spinlock_release(&vkd3d_failure_spin);
+
+    if (occurrence <= 3)
+        vkd3d_failure_write_line(category, msg, occurrence);
+}
+
+void vkd3d_failure_log(const char *category, const char *fmt, ...)
+{
+    char msg[2048];
+    va_list args;
+
+    if (!vkd3d_failure_log_enabled())
+        return;
+    va_start(args, fmt);
+    vsnprintf(msg, sizeof(msg), fmt, args);
+    va_end(args);
+    vkd3d_failure_log_message(category, msg);
+}
+
 void vkd3d_dbg_printf(enum vkd3d_dbg_channel channel, enum vkd3d_dbg_level level, const char *function, const char *fmt, ...)
 {
     unsigned int tid;
     FILE *log_file;
     va_list args;
 
+    /* Mirror errors and FIXMEs (unimplemented paths) into the failure log, regardless of VKD3D_DEBUG. */
+    if ((level == VKD3D_DBG_LEVEL_ERR || level == VKD3D_DBG_LEVEL_FIXME) && vkd3d_failure_log_enabled())
+    {
+        char msg[2048];
+        int n = snprintf(msg, sizeof(msg), "%s: ", function);
+        va_start(args, fmt);
+        if (n > 0 && n < (int)sizeof(msg))
+            vsnprintf(msg + n, sizeof(msg) - n, fmt, args);
+        va_end(args);
+        vkd3d_failure_log_message(level == VKD3D_DBG_LEVEL_ERR ? "error" : "fixme", msg);
+    }
+
     if (vkd3d_dbg_get_level(channel) < level)
         return;
     assert(level < ARRAY_SIZE(debug_level_names));
