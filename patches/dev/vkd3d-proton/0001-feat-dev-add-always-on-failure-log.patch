+/* Failure log: record HRESULT failures returned to the application from object creation. */
+static HRESULT vkd3d_note_create(struct d3d12_device *device, const char *what, HRESULT hr)
+{
+    if (FAILED(hr))
+        vkd3d_failure_log("create-failed", "%s failed, hr %#x", what, (unsigned int)hr);
+    return hr;
+}
+
+static HRESULT vkd3d_note_resource_create(struct d3d12_device *device, const char *what, HRESULT hr,
+        const D3D12_RESOURCE_DESC1 *desc)
+{
+    if (FAILED(hr))
+    {
+        vkd3d_failure_log("create-failed", "%s failed, hr %#x: dim %u, DXGI format %u, %"PRIu64"x%ux%u, mips %u, "
+                "samples %u, layout %u, flags %#x", what, (unsigned int)hr, desc->Dimension, desc->Format, desc->Width,
+                desc->Height, desc->DepthOrArraySize, desc->MipLevels, desc->SampleDesc.Count, desc->Layout,
+                (unsigned int)desc->Flags);
+    }
+    return hr;
+}
