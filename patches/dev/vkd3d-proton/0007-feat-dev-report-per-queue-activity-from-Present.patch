@@ -24228,6 +24245,14 @@ VKD3D_METHODENTRY(void) d3d12_command_queue_ExecuteCommandLists(ID3D12CommandQue
     {
         cmd_list = d3d12_command_list_from_iface(command_lists[i]);
 
+        if (cmd_list)
