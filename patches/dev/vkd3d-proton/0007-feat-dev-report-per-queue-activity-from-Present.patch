     TRACE("iface %p, fence %p, value %#"PRIx64".\n", iface, fence_iface, value);
 
+    InterlockedIncrement(&command_queue->diag_signals);
+    command_queue->diag_last_signal_value = value;
     d3d12_fence_iface_inc_ref((d3d12_fence_iface *)fence_iface);
 
     sub.type = VKD3D_SUBMISSION_SIGNAL;
@@ -24612,6 +24639,7 @@ VKD3D_METHODENTRY(HRESULT) d3d12_command_queue_Wait(ID3D12CommandQueue *iface,
 
     TRACE("iface %p, fence %p, value %#"PRIx64".\n", iface, fence_iface, value);
 
+    InterlockedIncrement(&command_queue->diag_waits);
     d3d12_fence_iface_inc_ref((d3d12_fence_iface *)fence_iface);
 
     if (!is_shared_ID3D12Fence(fence_iface))
@@ -26899,6 +26927,71 @@ fail:
     return hr;
 }
 
+/* Queue activity diagnostics: every queue is registered; vkd3d_queue_activity_report() (called from Present) logs
+ * each queue's submissions, copies, dispatches, signals and waits every 10 s. VKD3D_QUEUE_ACTIVITY_LOG=0 disables. */
+
+void vkd3d_queue_diag_set_creator(struct d3d12_command_queue *queue, const void *return_address)
+{
+#ifdef _WIN32
+    HMODULE module;
+    char path[MAX_PATH];
+    const char *base;
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            (LPCSTR)return_address, &module) && GetModuleFileNameA(module, path, sizeof(path)))
+    {
+        base = strrchr(path, '\\');
+        snprintf(queue->diag_creator, sizeof(queue->diag_creator), "%s", base ? base + 1 : path);
+    }
+#endif
+}
+
+void vkd3d_queue_activity_report(void)
+{
+    static const char *types[] = { "direct", "bundle", "compute", "copy", "video decode", "video process", "video encode" };
+    enum { MAX_LINES = 16 };
+    char lines[MAX_LINES][320];
+    struct d3d12_command_queue *queue;
+    unsigned int count = 0, i;
+    static int enabled = -1;
+    uint64_t now, interval;
+
+    if (enabled < 0)
+    {
+        char env[16];
+        enabled = vkd3d_diagnostics_enabled() && !(vkd3d_get_env_var("VKD3D_QUEUE_ACTIVITY_LOG", env, sizeof(env)) && env[0] == '0');
+    }
+    if (!enabled)
+        return;
+    now = vkd3d_get_current_time_ns();
+    pthread_mutex_lock(&vkd3d_queue_diag_lock);
+    interval = now - vkd3d_queue_diag_last_report;
+    if (vkd3d_queue_diag_last_report && interval < 10000000000ull)
+    {
+        pthread_mutex_unlock(&vkd3d_queue_diag_lock);
+        return;
+    }
+    if (!vkd3d_queue_diag_last_report)
+        interval = 0;
+    vkd3d_queue_diag_last_report = now;
+    LIST_FOR_EACH_ENTRY(queue, &vkd3d_queue_diag_list, struct d3d12_command_queue, diag_entry)
+    {
+        LONG ecl = InterlockedExchange(&queue->diag_ecl, 0), lists = InterlockedExchange(&queue->diag_lists, 0);
+        LONG sig = InterlockedExchange(&queue->diag_signals, 0), waits = InterlockedExchange(&queue->diag_waits, 0);
+        LONG disp = InterlockedExchange(&queue->diag_dispatches, 0), copies = InterlockedExchange(&queue->diag_copies, 0);
+        LONG64 bytes = InterlockedExchange64(&queue->diag_copy_bytes, 0);
+        if (count >= MAX_LINES || !interval)
+            continue;
+        snprintf(lines[count++], sizeof(lines[0]), "queue %u (%s, created by %s): in %.0f s: %ld submits (%ld lists: %ld dispatches, "
+                "%ld copies %.1f MB), %ld signals (last value %"PRIu64"), %ld waits",
+                queue->diag_id, queue->desc.Type < ARRAY_SIZE(types) ? types[queue->desc.Type] : "?",
+                queue->diag_creator[0] ? queue->diag_creator : "?", interval / 1e9, (long)ecl, (long)lists, (long)disp,
+                (long)copies, bytes / 1e6, (long)sig, queue->diag_last_signal_value, (long)waits);
+    }
+    pthread_mutex_unlock(&vkd3d_queue_diag_lock);
+    for (i = 0; i < count; i++)
+        vkd3d_failure_log("queue-activity", "%s", lines[i]);
+}
+
 HRESULT d3d12_command_queue_create(struct d3d12_device *device,
         const D3D12_COMMAND_QUEUE_DESC *desc, uint32_t vk_family_index, struct d3d12_command_queue **queue)
 {
@@ -26919,6 +27012,11 @@ HRESULT d3d12_command_queue_create(struct d3d12_device *device,
 
     TRACE("Created command queue %p.\n", object);
 
+    pthread_mutex_lock(&vkd3d_queue_diag_lock);
+    object->diag_id = ++vkd3d_queue_diag_next_id;
+    list_add_tail(&vkd3d_queue_diag_list, &object->diag_entry);
+    pthread_mutex_unlock(&vkd3d_queue_diag_lock);
+
     *queue = object;
 
     return S_OK;
