index d85dd7c..8f76a1a 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -10976,6 +10976,7 @@ bool d3d12_device_validate_shader_meta(struct d3d12_device *device, const struct
 HRESULT d3d12_device_create(struct vkd3d_instance *instance,
         const struct vkd3d_device_create_info *create_info, struct d3d12_device **device)
 {
+    vkd3d_start_thread_sampler();
     bool reject_existing_device = false;
     bool forced_singletons = false;
     struct d3d12_device *object;
