+  HRESULT DxgiFactory::CreateSwapChainForHwnd_Impl(
           IUnknown*             pDevice,
           HWND                  hWnd,
     const DXGI_SWAP_CHAIN_DESC1* pDesc,
@@ -584,4 +585,33 @@ namespace dxvk {
     return s_globalHDRState;
   }
 
+
+  HRESULT STDMETHODCALLTYPE DxgiFactory::CreateSwapChain(IUnknown* pDevice, DXGI_SWAP_CHAIN_DESC* pDesc, IDXGISwapChain** ppSwapChain) {
+    HRESULT hr = CreateSwapChain_Impl(pDevice, pDesc, ppSwapChain);
+    if (dxgiTraceEnabled()) {
+      if (pDesc) {
+        dxgiTrace("Factory::CreateSwapChain(%ux%u format %d, windowed %d, buffers %u, swap effect %d, flags %#x) -> hr %08x",
+          pDesc->BufferDesc.Width, pDesc->BufferDesc.Height, pDesc->BufferDesc.Format, pDesc->Windowed, pDesc->BufferCount, pDesc->SwapEffect, pDesc->Flags, hr);
+      RECT wr = {}, cr = {};
+      GetWindowRect(pDesc->OutputWindow, &wr); GetClientRect(pDesc->OutputWindow, &cr);
+      dxgiTrace("    window %p: window rect %ldx%ld at (%ld,%ld), client rect %ldx%ld, style %#lx", (void*)pDesc->OutputWindow, wr.right - wr.left, wr.bottom - wr.top, wr.left, wr.top,
+        cr.right - cr.left, cr.bottom - cr.top, GetWindowLongW(pDesc->OutputWindow, GWL_STYLE));
+      }
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiFactory::CreateSwapChainForHwnd(IUnknown* pDevice, HWND hWnd, const DXGI_SWAP_CHAIN_DESC1* pDesc, const DXGI_SWAP_CHAIN_FULLSCREEN_DESC* pFullscreenDesc, IDXGIOutput* pRestrictToOutput, IDXGISwapChain1** ppSwapChain) {
+    HRESULT hr = CreateSwapChainForHwnd_Impl(pDevice, hWnd, pDesc, pFullscreenDesc, pRestrictToOutput, ppSwapChain);
+    if (dxgiTraceEnabled()) {
+      if (pDesc) dxgiTrace("Factory::CreateSwapChainForHwnd(%ux%u format %d, scaling %d, buffers %u, swap effect %d, flags %#x, fullscreen desc %s windowed %d) -> hr %08x",
+        pDesc->Width, pDesc->Height, pDesc->Format, pDesc->Scaling, pDesc->BufferCount, pDesc->SwapEffect, pDesc->Flags,
+        pFullscreenDesc ? "yes" : "no", pFullscreenDesc ? pFullscreenDesc->Windowed : -1, hr);
+      RECT wr = {}, cr = {};
+      GetWindowRect(hWnd, &wr); GetClientRect(hWnd, &cr);
+      dxgiTrace("    window %p: window rect %ldx%ld at (%ld,%ld), client rect %ldx%ld, style %#lx", (void*)hWnd, wr.right - wr.left, wr.bottom - wr.top, wr.left, wr.top,
+        cr.right - cr.left, cr.bottom - cr.top, GetWindowLongW(hWnd, GWL_STYLE));
+    }
+    return hr;
+  }
 }
