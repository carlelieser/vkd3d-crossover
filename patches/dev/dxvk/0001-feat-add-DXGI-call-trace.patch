+
+  HRESULT STDMETHODCALLTYPE DxgiOutput::GetDesc(DXGI_OUTPUT_DESC* pDesc) {
+    HRESULT hr = GetDesc_Impl(pDesc);
+    if (dxgiTraceEnabled()) {
+      if (SUCCEEDED(hr) && pDesc) dxgiTrace("Output::GetDesc -> desktop (%ld,%ld)-(%ld,%ld) = %ldx%ld, attached %d, rotation %d",
+        pDesc->DesktopCoordinates.left, pDesc->DesktopCoordinates.top, pDesc->DesktopCoordinates.right, pDesc->DesktopCoordinates.bottom,
+        pDesc->DesktopCoordinates.right - pDesc->DesktopCoordinates.left, pDesc->DesktopCoordinates.bottom - pDesc->DesktopCoordinates.top,
+        pDesc->AttachedToDesktop, pDesc->Rotation);
+      else dxgiTrace("Output::GetDesc -> hr %08x", hr);
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiOutput::GetDesc1(DXGI_OUTPUT_DESC1* pDesc) {
+    HRESULT hr = GetDesc1_Impl(pDesc);
+    if (dxgiTraceEnabled()) {
+      if (SUCCEEDED(hr) && pDesc) dxgiTrace("Output::GetDesc1 -> desktop %ldx%ld at (%ld,%ld), bpc %u, colorspace %d, lum %.2f-%.1f (full frame %.1f)",
+        pDesc->DesktopCoordinates.right - pDesc->DesktopCoordinates.left, pDesc->DesktopCoordinates.bottom - pDesc->DesktopCoordinates.top,
+        pDesc->DesktopCoordinates.left, pDesc->DesktopCoordinates.top, pDesc->BitsPerColor, pDesc->ColorSpace,
+        pDesc->MinLuminance, pDesc->MaxLuminance, pDesc->MaxFullFrameLuminance);
+      else dxgiTrace("Output::GetDesc1 -> hr %08x", hr);
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiOutput::GetDisplayModeList(DXGI_FORMAT EnumFormat, UINT Flags, UINT* pNumModes, DXGI_MODE_DESC* pDesc) {
+    HRESULT hr = GetDisplayModeList_Impl(EnumFormat, Flags, pNumModes, pDesc);
+    if (dxgiTraceEnabled()) {
+      UINT n = pNumModes ? *pNumModes : 0;
+      if (!pDesc) { dxgiTrace("Output::%s(format %d, flags %#x, count query) -> %u modes, hr %08x", "GetDisplayModeList", EnumFormat, Flags, n, hr); }
+      else {
+        UINT maxW = 0, maxH = 0, idx882 = ~0u, first = 0;
+        for (UINT i = 0; i < n; i++) {
+          if (pDesc[i].Width * pDesc[i].Height > maxW * maxH) { maxW = pDesc[i].Width; maxH = pDesc[i].Height; }
+          if (pDesc[i].Width == 882 && idx882 == ~0u) idx882 = i;
+        }
+        dxgiTrace("Output::%s(format %d, flags %#x) -> %u modes, hr %08x, largest %ux%u, first 882-wide at %d", "GetDisplayModeList", EnumFormat, Flags, n, hr, maxW, maxH, (int)idx882);
+        for (UINT i = 0; i < n && i < 6; i++) dxgiTrace("    mode %u: %ux%u @ %u/%u scaling %d order %d", i, pDesc[i].Width, pDesc[i].Height,
+          pDesc[i].RefreshRate.Numerator, pDesc[i].RefreshRate.Denominator, pDesc[i].Scaling, pDesc[i].ScanlineOrdering);
+        for (UINT i = n > 6 ? n - 6 : n; i < n; i++) dxgiTrace("    mode %u: %ux%u @ %u/%u scaling %d order %d", i, pDesc[i].Width, pDesc[i].Height,
+          pDesc[i].RefreshRate.Numerator, pDesc[i].RefreshRate.Denominator, pDesc[i].Scaling, pDesc[i].ScanlineOrdering);
+        (void)first;
+      }
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiOutput::GetDisplayModeList1(DXGI_FORMAT EnumFormat, UINT Flags, UINT* pNumModes, DXGI_MODE_DESC1* pDesc) {
+    HRESULT hr = GetDisplayModeList1_Impl(EnumFormat, Flags, pNumModes, pDesc);
+    if (dxgiTraceEnabled()) {
+      UINT n = pNumModes ? *pNumModes : 0;
+      if (!pDesc) { dxgiTrace("Output::%s(format %d, flags %#x, count query) -> %u modes, hr %08x", "GetDisplayModeList1", EnumFormat, Flags, n, hr); }
+      else {
+        UINT maxW = 0, maxH = 0, idx882 = ~0u, first = 0;
+        for (UINT i = 0; i < n; i++) {
+          if (pDesc[i].Width * pDesc[i].Height > maxW * maxH) { maxW = pDesc[i].Width; maxH = pDesc[i].Height; }
+          if (pDesc[i].Width == 882 && idx882 == ~0u) idx882 = i;
+        }
+        dxgiTrace("Output::%s(format %d, flags %#x) -> %u modes, hr %08x, largest %ux%u, first 882-wide at %d", "GetDisplayModeList1", EnumFormat, Flags, n, hr, maxW, maxH, (int)idx882);
+        for (UINT i = 0; i < n && i < 6; i++) dxgiTrace("    mode %u: %ux%u @ %u/%u scaling %d order %d", i, pDesc[i].Width, pDesc[i].Height,
+          pDesc[i].RefreshRate.Numerator, pDesc[i].RefreshRate.Denominator, pDesc[i].Scaling, pDesc[i].ScanlineOrdering);
+        for (UINT i = n > 6 ? n - 6 : n; i < n; i++) dxgiTrace("    mode %u: %ux%u @ %u/%u scaling %d order %d", i, pDesc[i].Width, pDesc[i].Height,
+          pDesc[i].RefreshRate.Numerator, pDesc[i].RefreshRate.Denominator, pDesc[i].Scaling, pDesc[i].ScanlineOrdering);
+        (void)first;
+      }
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiOutput::FindClosestMatchingMode(const DXGI_MODE_DESC* pModeToMatch, DXGI_MODE_DESC* pClosestMatch, IUnknown* pConcernedDevice) {
+    HRESULT hr = FindClosestMatchingMode_Impl(pModeToMatch, pClosestMatch, pConcernedDevice);
+    if (dxgiTraceEnabled()) {
+      if (pModeToMatch) dxgiTrace("Output::%s(want %ux%u @ %u/%u format %d scaling %d) -> %ux%u @ %u/%u format %d, hr %08x", "FindClosestMatchingMode",
+        pModeToMatch->Width, pModeToMatch->Height, pModeToMatch->RefreshRate.Numerator, pModeToMatch->RefreshRate.Denominator, pModeToMatch->Format, pModeToMatch->Scaling,
+        pClosestMatch ? pClosestMatch->Width : 0, pClosestMatch ? pClosestMatch->Height : 0, pClosestMatch ? pClosestMatch->RefreshRate.Numerator : 0,
+        pClosestMatch ? pClosestMatch->RefreshRate.Denominator : 0, pClosestMatch ? pClosestMatch->Format : 0, hr);
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiOutput::FindClosestMatchingMode1(const DXGI_MODE_DESC1* pModeToMatch, DXGI_MODE_DESC1* pClosestMatch, IUnknown* pConcernedDevice) {
+    HRESULT hr = FindClosestMatchingMode1_Impl(pModeToMatch, pClosestMatch, pConcernedDevice);
+    if (dxgiTraceEnabled()) {
+      if (pModeToMatch) dxgiTrace("Output::%s(want %ux%u @ %u/%u format %d scaling %d) -> %ux%u @ %u/%u format %d, hr %08x", "FindClosestMatchingMode1",
+        pModeToMatch->Width, pModeToMatch->Height, pModeToMatch->RefreshRate.Numerator, pModeToMatch->RefreshRate.Denominator, pModeToMatch->Format, pModeToMatch->Scaling,
+        pClosestMatch ? pClosestMatch->Width : 0, pClosestMatch ? pClosestMatch->Height : 0, pClosestMatch ? pClosestMatch->RefreshRate.Numerator : 0,
+        pClosestMatch ? pClosestMatch->RefreshRate.Denominator : 0, pClosestMatch ? pClosestMatch->Format : 0, hr);
+    }
+    return hr;
+  }
 }
