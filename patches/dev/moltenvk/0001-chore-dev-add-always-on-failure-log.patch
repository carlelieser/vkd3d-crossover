 #pragma mark Rendering
 
+// Samples a 4x4 grid of the presented image every 30 presents and reports to the failure log when
+// only black frames are being presented. Diagnoses "game runs but the screen is black".
+struct MVKPresentProbe {
+	std::mutex lock;
+	id<MTLBuffer> buffer = nil;
+	uint32_t presentCount = 0;
+	bool unavailableLogged = false;
+	bool sawVisible = false;
+	bool blackLogged = false;
+	double created = now();
+	double blackSince = 0;
+	double lastBlackReport = 0;
+
+	static double now() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+
+	void update(bool black, uint32_t w, uint32_t h) {
+		std::lock_guard<std::mutex> guard(lock);
+		double t = now();
+		if ( !black ) {
+			if (blackSince && blackLogged) {
+				mvkLogFailure("present", "visible frames again after %.0f s of black (%ux%u)", t - blackSince, w, h);
+			}
+			if ( !sawVisible ) {
+				sawVisible = true;
+				mvkLogFailure("present", "first visible frame %ux%u, %.1f s after swapchain creation", w, h, t - created);
+			}
+			blackSince = 0;
+			blackLogged = false;
+			return;
+		}
+		if ( !blackSince ) { blackSince = t; }
+		if (t - blackSince >= 5.0 && ( !blackLogged || t - lastBlackReport >= 60.0)) {
+			mvkLogFailure("present", "only black frames presented for %.0f s (%ux%u)%s", t - blackSince, w, h,
+						  sawVisible ? "" : "; no visible frame on this swapchain yet");
+			blackLogged = true;
+			lastBlackReport = t;
+		}
+	}
+
+	~MVKPresentProbe() { [buffer release]; }
+};
+
+void MVKSwapchain::probePresentedImage(id<MTLTexture> mtlTexture, id<MTLCommandBuffer> mtlCmdBuff) {
+	if ( !mtlTexture || !mvkFailureLogEnabled() ) { return; }
+	if ( !_presentProbe ) { _presentProbe = std::make_shared<MVKPresentProbe>(); }
+	auto probe = _presentProbe;
+	if ((probe->presentCount++ % 30) != 0) { return; }
+
+	if (mtlTexture.framebufferOnly) {
+		if ( !probe->unavailableLogged ) {
+			probe->unavailableLogged = true;
+			mvkLogFailure("present", "black-frame check unavailable: swapchain images are framebuffer-only");
+		}
+		return;
+	}
+	// 0: 8-bit RGBA/BGRA, 1: 10:10:10:2, 2: RGBA16Float
+	uint32_t bpp = 4, kind = 0;
+	switch (mtlTexture.pixelFormat) {
+		case MTLPixelFormatBGRA8Unorm: case MTLPixelFormatBGRA8Unorm_sRGB:
+		case MTLPixelFormatRGBA8Unorm: case MTLPixelFormatRGBA8Unorm_sRGB:
+			break;
+		case MTLPixelFormatBGR10A2Unorm: case MTLPixelFormatRGB10A2Unorm:
+			kind = 1; break;
+		case MTLPixelFormatRGBA16Float:
+			bpp = 8; kind = 2; break;
+		default:
+			if ( !probe->unavailableLogged ) {
+				probe->unavailableLogged = true;
+				mvkLogFailure("present", "black-frame check unavailable for MTLPixelFormat %lu", (unsigned long)mtlTexture.pixelFormat);
+			}
+			return;
+	}
+	if ( !probe->buffer ) { probe->buffer = [getMTLDevice() newBufferWithLength: 16 * 8 options: MTLResourceStorageModeShared]; }	// retained
+
+	uint32_t w = (uint32_t)mtlTexture.width, h = (uint32_t)mtlTexture.height;
+	id<MTLBlitCommandEncoder> blit = [mtlCmdBuff blitCommandEncoder];
+	blit.label = @"MVK black-frame probe";
+	for (uint32_t j = 0; j < 4; j++) {
+		for (uint32_t i = 0; i < 4; i++) {
+			[blit copyFromTexture: mtlTexture
+					  sourceSlice: 0
+					  sourceLevel: 0
+					 sourceOrigin: MTLOriginMake(w * (2 * i + 1) / 8, h * (2 * j + 1) / 8, 0)
+					   sourceSize: MTLSizeMake(1, 1, 1)
+						 toBuffer: probe->buffer
+				destinationOffset: (j * 4 + i) * bpp
+		   destinationBytesPerRow: bpp
+		 destinationBytesPerImage: bpp];
+		}
+	}
+	[blit endEncoding];
+
+	id<MTLBuffer> buf = probe->buffer;
+	[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer> mcb) {
+		if (mcb.status != MTLCommandBufferStatusCompleted) { return; }
+		const uint8_t* d = (const uint8_t*)buf.contents;
+		bool black = true;
+		for (uint32_t k = 0; k < 16 && black; k++) {
+			if (kind == 2) {
+				uint16_t c[4]; memcpy(c, d + k * 8, 8);
+				black = !((c[0] | c[1] | c[2]) & 0x7FFF);
+			} else {
+				uint32_t px; memcpy(&px, d + k * 4, 4);
+				black = !(px & (kind == 1 ? 0x3FFFFFFFu : 0x00FFFFFFu));
+			}
+		}
+		probe->update(black, w, h);
+		static const bool verbose = getenv("MVK_PRESENT_PROBE_LOG") && getenv("MVK_PRESENT_PROBE_LOG")[0] == '1';
+		if (verbose) {
+			// Raw value of the sample at (3/8, 3/8) of the drawable, as presented.
+			if (kind == 2) {
+				uint16_t c[4]; memcpy(c, d + 5 * 8, 8);
+				mvkLogFailure("present-sample", "%ux%u RGBA16F %04x %04x %04x %04x", w, h, c[0], c[1], c[2], c[3]);
+			} else {
+				uint32_t px; memcpy(&px, d + 5 * 4, 4);
+				if (kind == 1)
+					mvkLogFailure("present-sample", "%ux%u 10:10:10:2 r=%u g=%u b=%u a=%u (lsb first)", w, h,
+								  px & 0x3FF, (px >> 10) & 0x3FF, (px >> 20) & 0x3FF, px >> 30);
+				else
+					mvkLogFailure("present-sample", "%ux%u 8-bit bytes %u %u %u %u", w, h,
+								  px & 0xFF, (px >> 8) & 0xFF, (px >> 16) & 0xFF, px >> 24);
+			}
+		}
+	}];
+}
