+#pragma mark -
+#pragma mark Failure log
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <mutex>
+#include <unordered_map>
+#include <chrono>
+#include <ctime>
+#include <sys/time.h>
+
+namespace {
+
+struct MVKFailureLog {
+	std::mutex lock;
+	int fd = -1;
+	struct Entry { uint64_t count = 0; uint64_t reported = 0; };
+	std::unordered_map<std::string, Entry> entries;
+	std::chrono::steady_clock::time_point lastSummary = std::chrono::steady_clock::now();
+
+	MVKFailureLog() {
+		const char* env = getenv("MVK_FAILURE_LOG");
+		if (env && (!strcmp(env, "0") || !strcasecmp(env, "off"))) { return; }
+		std::string path;
+		if (env && *env) {
+			path = env;
+		} else if (const char* pfx = getenv("WINEPREFIX"); pfx && *pfx) {
+			path = std::string(pfx) + "/drive_c/gfx-failures.log";
+		} else if (const char* home = getenv("HOME"); home && *home) {
+			path = std::string(home) + "/Library/Logs/gfx-failures.log";
+		} else {
+			return;
+		}
+		fd = open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+		if (fd >= 0) { writeLine("process", "MoltenVK loaded (%s)", getprogname()); }
+	}
+
+	// Collapses numbers and hex so the same failure with different handles or sizes dedups to one key.
+	static std::string makeKey(const char* category, const char* msg) {
+		std::string key(category);
+		key += ':';
+		for (const char* p = msg; *p && key.size() < 240; p++) {
+			if (p[0] == '0' && p[1] == 'x') { key += '#'; p += 2; while (isxdigit(*p)) { p++; } p--; continue; }
+			if (isdigit(*p)) { key += '#'; while (isdigit(p[1])) { p++; } continue; }
+			if (*p == '\n') { break; }
+			key += *p;
+		}
+		return key;
+	}
+
+	void writeRaw(const std::string& s) { if (fd >= 0) { (void)!write(fd, s.data(), s.size()); } }
+
+	void writeLine(const char* category, const char* fmt, ...) __attribute__((format(printf, 3, 4))) {
+		char msg[512];
+		va_list args;
+		va_start(args, fmt);
+		vsnprintf(msg, sizeof(msg), fmt, args);
+		va_end(args);
+		writeRaw(prefix(category) + msg + "\n");
+	}
+
+	static std::string prefix(const char* category) {
+		struct timeval tv; gettimeofday(&tv, nullptr);
+		struct tm tmv; localtime_r(&tv.tv_sec, &tmv);
+		char buf[96];
+		snprintf(buf, sizeof(buf), "%02d:%02d:%02d.%03d mvk[%d] %s: ", tmv.tm_hour, tmv.tm_min, tmv.tm_sec,
+				 (int)(tv.tv_usec / 1000), (int)getpid(), category);
+		return buf;
+	}
+
+	// Writes the message, keeping only the first lines of long multi-line messages (e.g. MSL compiler output).
+	void writeMessage(const char* category, const char* msg, uint64_t occurrence) {
+		std::string out = prefix(category);
+		if (occurrence > 1) { out += "[#" + std::to_string(occurrence) + "] "; }
+		int lines = 0;
+		for (const char* p = msg; *p; p++) {
+			if (*p == '\n') {
+				if (!p[1]) { break; }
+				if (++lines >= 8 || out.size() > 1500) { out += "\n    ..."; break; }
+				out += "\n    ";
+				continue;
+			}
+			out += *p;
+		}
+		out += '\n';
+		writeRaw(out);
+	}
+
+	void flushSummaryLocked(bool force) {
+		auto now = std::chrono::steady_clock::now();
+		if (!force && now - lastSummary < std::chrono::seconds(10)) { return; }
+		lastSummary = now;
+		for (auto& [key, e] : entries) {
+			if (e.count > e.reported) {
+				writeLine("repeat", "+%llu more: %s", (unsigned long long)(e.count - e.reported), key.c_str());
+				e.reported = e.count;
+			}
+		}
+	}
+
+	void log(const char* category, const char* msg) {
+		if (fd < 0) { return; }
+		std::lock_guard<std::mutex> guard(lock);
+		auto& e = entries[makeKey(category, msg)];
+		e.count++;
+		if (e.count <= 3) {
+			writeMessage(category, msg, e.count);
+			e.reported = e.count;
+		}
+		flushSummaryLocked(false);
+	}
+};
+
+MVKFailureLog& mvkFailureLogInstance() {
+	static MVKFailureLog* inst = [] {
+		auto* l = new MVKFailureLog();	// Leaked on purpose: usable from completion handlers during teardown.
+		atexit([] { auto& f = mvkFailureLogInstance(); std::lock_guard<std::mutex> g(f.lock); f.flushSummaryLocked(true); });
+		return l;
+	}();
+	return *inst;
+}
+
+}
+
+bool mvkFailureLogEnabled() { return mvkFailureLogInstance().fd >= 0; }
+
+void mvkLogFailure(const char* category, const char* format, ...) {
+	auto& fl = mvkFailureLogInstance();
+	if (fl.fd < 0) { return; }
+	char buf[4096];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(buf, sizeof(buf), format, args);
+	va_end(args);
+	fl.log(category, buf);
+}
