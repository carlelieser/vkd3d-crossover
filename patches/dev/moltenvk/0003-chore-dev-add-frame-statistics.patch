diff --git a/MoltenVK/MoltenVK/Utility/MVKFrameStats.h b/MoltenVK/MoltenVK/Utility/MVKFrameStats.h
new file mode 100644
index 0000000..f62c4cf
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKFrameStats.h
@@ -0,0 +1,82 @@
+/*
+ * MVKFrameStats.h — lightweight frame profiling for MoltenVK under vkd3d-proton (diagnostics).
+ * MVK_FRAME_STATS=1 enables. Every 2 s of presents it writes one "frame-stats" line to the failure log:
+ * FPS, average and worst present-to-present interval, GPU busy time per frame (sum of Metal command buffer
+ * GPU time), command buffers per frame, and shader/pipeline compile work done during that interval.
+ */
+#pragma once
+
+#include "MVKBaseObject.h"
+#include <atomic>
+#include <mach/mach_time.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string>
+#include <ctime>
+#include <unistd.h>
+
+enum MVKFrameStatKind { kMVKStatSPIRVToMSL = 0, kMVKStatMSLCompile, kMVKStatRenderPSO, kMVKStatComputePSO, kMVKStatPSOWait, kMVKStatCount };
+
+inline bool mvkFrameStatsEnabled() {
+	static const bool enabled = getenv("MVK_FRAME_STATS") && getenv("MVK_FRAME_STATS")[0] == '1';
+	return enabled;
+}
+
+inline uint64_t mvkFrameStatsNowNs() {
+	static mach_timebase_info_data_t tb = [] { mach_timebase_info_data_t t; mach_timebase_info(&t); return t; }();
+	return mach_absolute_time() * tb.numer / tb.denom;
+}
+
+inline std::atomic<uint64_t> mvkFrameStatNs[kMVKStatCount];
+inline std::atomic<uint32_t> mvkFrameStatCount[kMVKStatCount];
+inline std::atomic<uint64_t> mvkFrameStatGPUNs;
+inline std::atomic<uint32_t> mvkFrameStatCmdBufs;
+
+struct MVKFrameStatTimer {
+	int kind; uint64_t t0;
+	MVKFrameStatTimer(int k) : kind(k), t0(mvkFrameStatsEnabled() ? mvkFrameStatsNowNs() : 0) {}
+	~MVKFrameStatTimer() {
+		if ( !t0 ) { return; }
+		mvkFrameStatNs[kind] += mvkFrameStatsNowNs() - t0;
+		mvkFrameStatCount[kind]++;
+	}
+};
+
+inline void mvkFrameStatsAddCommandBuffer(double gpuStart, double gpuEnd) {
+	if ( !mvkFrameStatsEnabled() ) { return; }
+	if (gpuEnd > gpuStart) { mvkFrameStatGPUNs += (uint64_t)((gpuEnd - gpuStart) * 1e9); }
+	mvkFrameStatCmdBufs++;
+}
+
+inline void mvkFrameStatsOnPresent() {
+	if ( !mvkFrameStatsEnabled() ) { return; }
+	static std::atomic<uint64_t> windowStart{0}, lastPresent{0}, worstNs{0};
+	static std::atomic<uint32_t> frames{0};
+	uint64_t now = mvkFrameStatsNowNs();
+	uint64_t prev = lastPresent.exchange(now);
+	if ( !windowStart.load() ) { windowStart = now; return; }
+	if (prev && now - prev > worstNs.load()) { worstNs = now - prev; }
+	uint32_t f = ++frames;
+	uint64_t elapsed = now - windowStart.load();
+	if (elapsed < 2000000000ull) { return; }
+	windowStart = now; frames = 0;
+	uint64_t worst = worstNs.exchange(0), gpu = mvkFrameStatGPUNs.exchange(0);
+	uint32_t cbs = mvkFrameStatCmdBufs.exchange(0);
+	uint64_t ns[kMVKStatCount]; uint32_t n[kMVKStatCount];
+	for (int k = 0; k < kMVKStatCount; k++) { ns[k] = mvkFrameStatNs[k].exchange(0); n[k] = mvkFrameStatCount[k].exchange(0); }
+	double sec = elapsed / 1e9, fps = f / sec;
+	// Own file, never collapsed: $WINEPREFIX/drive_c/gfx-frames.log
+	static FILE* out = [] {
+		const char* pfx = getenv("WINEPREFIX");
+		std::string path = std::string(pfx ? pfx : "/tmp") + (pfx ? "/drive_c/gfx-frames.log" : "/gfx-frames.log");
+		FILE* f = fopen(path.c_str(), "a");
+		if (f) { setvbuf(f, nullptr, _IOLBF, 0); }
+		return f;
+	}();
+	if ( !out ) { return; }
+	time_t tnow = time(nullptr); struct tm lt; localtime_r(&tnow, &lt);
+	fprintf(out, "%02d:%02d:%02d [%d] %.1f fps (avg %.1f ms, worst %.1f ms) | GPU busy %.1f ms/frame (%.0f%% of frame time), %.1f cmd bufs/frame"
+				  " | compiles: SPIR-V->MSL %u (%.0f ms), MSL->lib %u (%.0f ms), render PSO %u (%.0f ms), compute PSO %u (%.0f ms) | draws waited on PSO %u (%.0f ms)\n",
+				  lt.tm_hour, lt.tm_min, lt.tm_sec, (int)getpid(), fps, 1000.0 / fps, worst / 1e6, gpu / 1e6 / f, 100.0 * (gpu / 1e9) / sec, (double)cbs / f,
+				  n[0], ns[0] / 1e6, n[1], ns[1] / 1e6, n[2], ns[2] / 1e6, n[3], ns[3] / 1e6, n[4], ns[4] / 1e6);
+}
