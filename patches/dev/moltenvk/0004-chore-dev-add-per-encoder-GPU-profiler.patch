+#pragma mark -
+#pragma mark GPU profiler (MVK_CONFIG_GPU_PROFILE=1)
+
+// Times every Metal encoder with stage-boundary GPU timestamps (Apple GPUs) and logs, every 5 s, the GPU time per
+// render pass (keyed by attachments and size) and per compute encoder (keyed by the first compute shader's code hash,
+// matching MVK_CONFIG_SHADER_DUMP_DIR file names). Diagnostic only; adds a little overhead.
+
+#include <map>
+#include <chrono>
+
+struct MVKGPUProfileBatch {
+	id<MTLCounterSampleBuffer> sampleBuffer = nil;
+	uint32_t next = 0;
+	std::vector<std::string> keys;
+	~MVKGPUProfileBatch() { [sampleBuffer release]; }
+};
+
+static constexpr uint32_t kMVKGPUProfileSlots = 2048;
+
+static bool mvkGPUProfileEnabled() {
+	static int enabled = -1;
+	if (enabled < 0) { const char* e = getenv("MVK_CONFIG_GPU_PROFILE"); enabled = (e && e[0] == '1'); }
+	return enabled;
+}
+
+static std::mutex& mvkGPUProfileLock() { static std::mutex m; return m; }
+static std::map<std::string, std::pair<double, uint64_t>>& mvkGPUProfileTotals() { static std::map<std::string, std::pair<double, uint64_t>> t; return t; }
+
+static void mvkGPUProfileAccumulate(MVKGPUProfileBatch* batch) {
+	if ( !batch->next ) { return; }
+	NSData* data = [batch->sampleBuffer resolveCounterRange: NSMakeRange(0, batch->next)];
+	if ( !data ) { return; }
+	const MTLCounterResultTimestamp* ts = (const MTLCounterResultTimestamp*)data.bytes;
+	size_t count = data.length / sizeof(MTLCounterResultTimestamp);
+
+	static auto lastReport = std::chrono::steady_clock::now();
+	static auto windowStart = lastReport;
+	std::lock_guard<std::mutex> lock(mvkGPUProfileLock());
+	auto& totals = mvkGPUProfileTotals();
+	for (size_t i = 0; i + 1 < count && i / 2 < batch->keys.size(); i += 2) {
+		uint64_t a = ts[i].timestamp, b = ts[i + 1].timestamp;
+		if (a == MTLCounterErrorValue || b == MTLCounterErrorValue || b < a) { continue; }
+		auto& e = totals[batch->keys[i / 2]];
+		e.first += double(b - a);	// Apple GPU timestamps are nanoseconds (timestampPeriod 1.0)
+		e.second++;
+	}
+	auto now = std::chrono::steady_clock::now();
+	double secs = std::chrono::duration<double>(now - windowStart).count();
+	if (std::chrono::duration<double>(now - lastReport).count() >= 5.0 && secs > 0) {
+		std::vector<std::pair<std::string, std::pair<double, uint64_t>>> v(totals.begin(), totals.end());
+		std::sort(v.begin(), v.end(), [](auto& x, auto& y) { return x.second.first > y.second.first; });
+		double all = 0; for (auto& x : v) { all += x.second.first; }
+		fprintf(stderr, "[mvk-gpuprof] window %.1fs: total encoder GPU time %.1f ms/s across %zu keys\n", secs, all / 1e6 / secs, v.size());
+		for (size_t i = 0; i < v.size() && i < 25; i++) {
+			fprintf(stderr, "[mvk-gpuprof] %7.2f ms/s %5.1f%%  n=%-6llu avg %7.3f ms  %s\n", v[i].second.first / 1e6 / secs,
+					all > 0 ? 100.0 * v[i].second.first / all : 0.0, (unsigned long long)v[i].second.second,
+					v[i].second.first / 1e6 / double(v[i].second.second), v[i].first.c_str());
+		}
+		fflush(stderr);
+		totals.clear();
+		lastReport = windowStart = now;
+	}
+}
+
+MVKGPUProfileBatch* MVKCommandEncoder::profBatch() {
+	if ( !mvkGPUProfileEnabled() || !_mtlCmdBuffer ) { return nullptr; }
+	if (_profCmdBuffer == _mtlCmdBuffer && _profBatch) { return _profBatch.get(); }
+
+	static id<MTLCounterSet> tsSet = nil;
+	static bool supported = false;
+	static std::once_flag once;
+	id<MTLDevice> mtlDev = getMTLDevice();
+	std::call_once(once, [&]() {
+		if ( ![mtlDev supportsCounterSampling: MTLCounterSamplingPointAtStageBoundary] ) { return; }
+		for (id<MTLCounterSet> cs in mtlDev.counterSets) {
+			if ([cs.name isEqualToString: MTLCommonCounterSetTimestamp]) { tsSet = [cs retain]; supported = true; }
+		}
+	});
+	if ( !supported ) { return nullptr; }
+
+	auto batch = std::make_shared<MVKGPUProfileBatch>();
+	@autoreleasepool {
+		MTLCounterSampleBufferDescriptor* d = [[MTLCounterSampleBufferDescriptor new] autorelease];
+		d.counterSet = tsSet;
+		d.storageMode = MTLStorageModeShared;
+		d.sampleCount = kMVKGPUProfileSlots;
+		NSError* err = nil;
+		batch->sampleBuffer = [mtlDev newCounterSampleBufferWithDescriptor: d error: &err];
+	}
+	if ( !batch->sampleBuffer ) { return nullptr; }
+	std::shared_ptr<MVKGPUProfileBatch> keep = batch;
+	[_mtlCmdBuffer addCompletedHandler: ^(id<MTLCommandBuffer>) { mvkGPUProfileAccumulate(keep.get()); }];
+	_profBatch = batch;
+	_profCmdBuffer = _mtlCmdBuffer;
+	_profComputeSlot = -1;
+	return _profBatch.get();
+}
+
+int32_t MVKCommandEncoder::profAllocSlot(const std::string& key) {
+	auto* batch = profBatch();
+	if ( !batch || batch->next + 2 > kMVKGPUProfileSlots ) { return -1; }
+	int32_t slot = (int32_t)batch->next;
+	batch->next += 2;
+	batch->keys.push_back(key);
+	return slot;
+}
+
+void MVKCommandEncoder::profNoteComputeShader(uint64_t shaderHash) {
+	if (_profComputeSlot < 0 || !_profBatch || _profCmdBuffer != _mtlCmdBuffer) { return; }
+	auto& key = _profBatch->keys[_profComputeSlot / 2];
+	if (key.size() <= 3) {		// still the bare "CS " placeholder: name it after the first shader dispatched
+		char buf[48];
+		snprintf(buf, sizeof(buf), "CS %016llx", (unsigned long long)shaderHash);
+		key = buf;
+	}
+}
+
+// Names the render pass after its first fragment shader (and how many distinct draws were made before the key froze),
+// so heavy passes can be matched to MVK_PROFILE_SHADER_DIR dumps.
+void MVKCommandEncoder::profNoteRenderDraw(uint64_t fragmentHash) {
+	if (_profRenderSlot < 0 || !_profBatch || _profCmdBuffer != _mtlCmdBuffer) { return; }
+	auto& key = _profBatch->keys[_profRenderSlot / 2];
+	if (key.find(" fs ") == std::string::npos && fragmentHash) {
+		char buf[40];
+		snprintf(buf, sizeof(buf), " fs %016llx", (unsigned long long)fragmentHash);
+		key += buf;
+	}
+}
+
+static std::string mvkProfRenderPassKey(MTLRenderPassDescriptor* rpd) {
+	std::string k = "RP";
+	NSUInteger w = 0, h = 0;
+	for (uint32_t i = 0; i < 8; i++) {
+		id<MTLTexture> t = rpd.colorAttachments[i].texture;
+		if ( !t ) { continue; }
+		w = t.width; h = t.height;
+		k += " c" + std::to_string((unsigned)t.pixelFormat);
+		if (t.sampleCount > 1) { k += "x" + std::to_string((unsigned)t.sampleCount); }
+	}
+	id<MTLTexture> dt = rpd.depthAttachment.texture;
+	if (dt) { if ( !w ) { w = dt.width; h = dt.height; } k += " d" + std::to_string((unsigned)dt.pixelFormat); }
+	if ( !w ) { w = rpd.renderTargetWidth; h = rpd.renderTargetHeight; k += " noatt"; }
+	k += " " + std::to_string((unsigned)w) + "x" + std::to_string((unsigned)h);
+	return k;
+}
