From e52ff8a6af14895c82e4ebe8ef1476746a031e22 Mon Sep 17 00:00:00 2001
From: vkd3d-crossover <noreply@vkd3d-crossover.invalid>
Date: Tue, 17 Nov 2026 01:12:15 -0500
Subject: [PATCH 06/10] chore(dev): add per-render-pass and copy probes

Problem: Needed to locate which pass produced black, NaN or saturated values.

Root cause: Diagnostics only; no defect.

Fix: MVK_PASS_PROBE=1: at 10 s and then every 20 s after the first present (up to 40 frames) one frame is captured; after each Metal render pass 24 rows of every color target are copied and summarized into $WINEPREFIX/drive_c/gfx-passes.log (draw kinds, fs/cs hashes, zero/NaN/Inf counts, hot-value histogram, texture identity). Copy probe: identifies the texture behind single-row image->buffer copies.

Verified by: Located the hair pass and the k-buffer compositor.

Off switch: off by default; MVK_PASS_PROBE=1 enables
---
 MoltenVK/MoltenVK/Commands/MVKCmdDispatch.mm  |   2 +
 MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm      |   6 +
 MoltenVK/MoltenVK/Commands/MVKCmdTransfer.mm  |  10 +
 MoltenVK/MoltenVK/Commands/MVKCommandBuffer.h |  23 ++
 .../MoltenVK/Commands/MVKCommandBuffer.mm     | 346 ++++++++++++++++++
 .../Commands/MVKCommandEncoderState.mm        |   6 +-
 MoltenVK/MoltenVK/GPUObjects/MVKSwapchain.mm  |   2 +
 7 files changed, 394 insertions(+), 1 deletion(-)

diff --git a/MoltenVK/MoltenVK/Commands/MVKCmdDispatch.mm b/MoltenVK/MoltenVK/Commands/MVKCmdDispatch.mm
index 2a7eff4..dbc836b 100644
--- a/MoltenVK/MoltenVK/Commands/MVKCmdDispatch.mm
+++ b/MoltenVK/MoltenVK/Commands/MVKCmdDispatch.mm
@@ -43,6 +43,7 @@ VkResult MVKCmdDispatch::setContent(MVKCommandBuffer* cmdBuff,
 }
 
 void MVKCmdDispatch::encode(MVKCommandEncoder* cmdEncoder) {
+	mvkPassProbeNoteDispatch();
 	MTLRegion mtlThreadgroupCount = MTLRegionMake3D(_baseGroupX, _baseGroupY, _baseGroupZ, _groupCountX, _groupCountY, _groupCountZ);
 	cmdEncoder->finalizeDispatchState();	// Ensure all updated state has been submitted to Metal
 	id<MTLComputeCommandEncoder> mtlEncoder = cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDispatch);
@@ -69,6 +70,7 @@ VkResult MVKCmdDispatchIndirect::setContent(MVKCommandBuffer* cmdBuff, VkBuffer
 }
 
 void MVKCmdDispatchIndirect::encode(MVKCommandEncoder* cmdEncoder) {
+	mvkPassProbeNoteDispatch();
     cmdEncoder->finalizeDispatchState();	// Ensure all updated state has been submitted to Metal
     [cmdEncoder->getMTLComputeEncoder(kMVKCommandUseDispatch) dispatchThreadgroupsWithIndirectBuffer: _mtlIndirectBuffer
 																				indirectBufferOffset: _mtlIndirectBufferOffset
