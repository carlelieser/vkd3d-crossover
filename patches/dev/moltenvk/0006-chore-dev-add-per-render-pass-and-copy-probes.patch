@@ -1269,6 +1272,7 @@ void MVKCmdDrawIndexedIndirect::hoistCountConversion(MVKCommandEncoder* cmdEncod
 }
 
 void MVKCmdDrawIndexedIndirect::encode(MVKCommandEncoder* cmdEncoder) {
