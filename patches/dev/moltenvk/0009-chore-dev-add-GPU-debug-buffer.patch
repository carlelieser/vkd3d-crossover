 .../Commands/MVKCommandEncoderState.mm        |  5 ++
 MoltenVK/MoltenVK/Utility/MVKDebugBuffer.h    | 77 +++++++++++++++++++
 3 files changed, 84 insertions(+)
 create mode 100644 MoltenVK/MoltenVK/Utility/MVKDebugBuffer.h

