diff --git a/MoltenVK/MoltenVK/Utility/MVKDebugBuffer.h b/MoltenVK/MoltenVK/Utility/MVKDebugBuffer.h
new file mode 100644
index 0000000..cd3398d
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKDebugBuffer.h
@@ -0,0 +1,77 @@
+/*
+ * MVKDebugBuffer.h
+ *
+ * Diagnostics only (MVK_DEBUG_BUFFER=1): a shared buffer bound at Metal buffer index 20 for every fragment and
+ * compute pipeline, so hand-instrumented shaders (MVK_MSL_OVERRIDE_DIR) can record values ("GPU printf").
+ * Layout (uint32 words): [0] record counter, records of 64 words from word 64. A shader reserves a record with
+ * atomic_fetch_add on word 0 and writes it only if the slot is below kMaxRecords. Every 2 s (on present) the
+ * recorded words are appended to $WINEPREFIX/drive_c/gfx-dbg.bin as: "MVKDBG01", uint32 count, count * 64 words,
+ * and the counter is reset.
+ */
+
+#pragma once
+
+#import <Metal/Metal.h>
+#include <mutex>
+#include <chrono>
+#include <string>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <unistd.h>
+
+class MVKDebugBuffer {
+public:
+	static constexpr uint32_t kIndex = 20;
+	static constexpr uint32_t kRecordWords = 64;
+	static constexpr uint32_t kMaxRecords = 8192;
+	static constexpr uint32_t kHeaderWords = 64;
+
+	static MVKDebugBuffer& get() { static MVKDebugBuffer* d = new MVKDebugBuffer(); return *d; }
+
+	bool enabled() const { return _enabled; }
+
+	id<MTLBuffer> buffer(id<MTLDevice> dev) {
+		if ( !_enabled ) { return nil; }
+		std::lock_guard<std::mutex> lock(_lock);
+		if ( !_buffer ) {
+			NSUInteger len = (kHeaderWords + kMaxRecords * kRecordWords) * 4;
+			_buffer = [dev newBufferWithLength: len options: MTLResourceStorageModeShared];
+			memset(_buffer.contents, 0, len);
+		}
+		return _buffer;
+	}
+
+	void onPresent() {
+		if ( !_enabled || !_buffer ) { return; }
+		double t = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+		std::lock_guard<std::mutex> lock(_lock);
+		if (t - _lastDump < 2.0 || _dumps >= 400) { return; }
+		_lastDump = t;
+		volatile uint32_t* w = (volatile uint32_t*)_buffer.contents;
+		uint32_t count = w[0];
+		if ( !count ) { return; }
+		if (count > kMaxRecords) { count = kMaxRecords; }
+		std::string path;
+		if (const char* pfx = getenv("WINEPREFIX")) { path = std::string(pfx) + "/drive_c/gfx-dbg.bin"; }
+		else { path = "/tmp/gfx-dbg.bin"; }
+		int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND, 0644);
+		if (fd >= 0) {
+			ssize_t r = write(fd, "MVKDBG01", 8);
+			r = write(fd, &count, 4);
+			r = write(fd, (const void*)(w + kHeaderWords), (size_t)count * kRecordWords * 4);
+			(void)r;
+			close(fd);
+		}
+		w[0] = 0;
+		_dumps++;
+	}
+
+private:
+	MVKDebugBuffer() { const char* e = getenv("MVK_DEBUG_BUFFER"); const char* o = getenv("MVK_MSL_OVERRIDE_DIR"); _enabled = (e && e[0] == '1') || (o && *o && !(e && e[0] == '0')); }
+	bool _enabled = false;
+	std::mutex _lock;
+	id<MTLBuffer> _buffer = nil;
+	double _lastDump = 0;
+	int _dumps = 0;
+};
