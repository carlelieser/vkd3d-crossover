 	unique_lock<mutex> lock(_completionLock);
 
 	compile(lock, ^{
@@ -3477,6 +3480,9 @@ id<MTLRenderPipelineState> MVKRenderPipelineCompiler::newMTLRenderPipelineState(
 }
 
