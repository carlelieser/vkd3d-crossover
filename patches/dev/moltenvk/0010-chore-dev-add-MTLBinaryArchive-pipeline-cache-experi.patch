+		variant = MVKBinaryArchiveCache::get(getMTLDevice()).render(desc);	// retained; nil on an archive miss
 		if ( !variant ) { variant = [getMTLDevice() newRenderPipelineStateWithDescriptor: desc error: &err]; }	// retained
 		if ( !variant && (depth != _plDepthFormat || stencil != _plStencilFormat) ) {
 			desc.depthAttachmentPixelFormat = depth ? depth : _plDepthFormat;
@@ -3460,6 +3462,7 @@ MVKPipelineCache::~MVKPipelineCache() {
 
