+/* Diagnostics: one-time GPU readback of the images involved in the final composite. Armed by the backbuffer-draw
+ * logger; performed right after the command list containing the draw is submitted. Windows builds only. */
+static struct d3d12_command_list *vkd3d_diag_rb_list;
+static const struct d3d12_resource *vkd3d_diag_rb_res[4];
+static uint32_t vkd3d_diag_rb_state[4];
+static const char *vkd3d_diag_rb_role[4];
+static unsigned int vkd3d_diag_rb_count;
+static bool vkd3d_diag_rb_busy;
