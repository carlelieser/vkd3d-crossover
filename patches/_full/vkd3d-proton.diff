+    pthread_mutex_lock(&vkd3d_pso_retry_lock);
+    vkd3d_pso_retry_total++;
+    if (vkd3d_pso_retry_count < VKD3D_PSO_RETRY_MAX)
+        vkd3d_pso_retry_hashes[vkd3d_pso_retry_count++] = hash;
+    pthread_mutex_unlock(&vkd3d_pso_retry_lock);
+}
+
+static void vkd3d_pso_retry_note_created(uint64_t hash)
+{
+    unsigned int i;
+    bool found = false;
+    pthread_mutex_lock(&vkd3d_pso_retry_lock);
+    for (i = 0; i < vkd3d_pso_retry_count; i++)
+    {
+        if (vkd3d_pso_retry_hashes[i] == hash)
+        {
+            vkd3d_pso_retry_hashes[i] = vkd3d_pso_retry_hashes[--vkd3d_pso_retry_count];
+            vkd3d_pso_retry_done++;
+            found = true;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&vkd3d_pso_retry_lock);
+    if (found)
+        vkd3d_failure_log("pso-retry", "PSO with rejected cached blob was recreated successfully");
+}
+
+void vkd3d_pso_retry_report(void)
+{
+    unsigned int pending, done, total;
+    uint64_t now = vkd3d_get_current_time_ns();
+    pthread_mutex_lock(&vkd3d_pso_retry_lock);
+    if (!vkd3d_pso_retry_total || now - vkd3d_pso_retry_last_report < 60ull * 1000000000ull)
+    {
+        pthread_mutex_unlock(&vkd3d_pso_retry_lock);
+        return;
+    }
+    vkd3d_pso_retry_last_report = now;
+    pending = vkd3d_pso_retry_count; done = vkd3d_pso_retry_done; total = vkd3d_pso_retry_total;
+    pthread_mutex_unlock(&vkd3d_pso_retry_lock);
+    vkd3d_failure_log("pso-retry", "status: %u PSOs had their cached blob rejected, %u recreated without it, %u never recreated",
+            total, done, pending);
+}
