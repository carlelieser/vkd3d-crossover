+/* Diagnostics: one raw line per rejected cached PSO blob in C:\\gfx-pso-mismatch.log (never collapsed), with the
+ * requested and stored state hashes and whether root signature and shaders match, so a game's own cache file can be
+ * cross-checked offline. VKD3D_PSO_MISMATCH_LOG=0 disables. */
+static void vkd3d_pso_mismatch_record(const struct vkd3d_pipeline_cache_compatibility *want,
+        const struct vkd3d_pipeline_cache_compatibility *have)
+{
+#ifdef _WIN32
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    static FILE *f;
+    static int enabled = -1;
+    unsigned int i, same_shaders = 1;
+    char env[16];
+
+    if (enabled < 0)
+        enabled = !(vkd3d_get_env_var("VKD3D_PSO_MISMATCH_LOG", env, sizeof(env)) && env[0] == '0');
+    if (!enabled)
+        return;
+    for (i = 0; i < ARRAY_SIZE(want->dxbc_blob_hashes); i++)
+        if (want->dxbc_blob_hashes[i] != have->dxbc_blob_hashes[i])
+            same_shaders = 0;
+    pthread_mutex_lock(&lock);
+    if (!f)
+        f = fopen("C:\\gfx-pso-mismatch.log", "a");
+    if (f)
+    {
+        fprintf(f, "want %016"PRIx64" have %016"PRIx64" rootsig %s shaders %s |", want->state_desc_compat_hash,
+                have->state_desc_compat_hash, want->root_signature_compat_hash == have->root_signature_compat_hash ? "same" : "DIFF",
+                same_shaders ? "same" : "DIFF");
+        for (i = 0; i < ARRAY_SIZE(want->dxbc_blob_hashes); i++)
+            fprintf(f, " %016"PRIx64, want->dxbc_blob_hashes[i]);
