+  HRESULT STDMETHODCALLTYPE DxgiSwapChain::GetDesc1(DXGI_SWAP_CHAIN_DESC1* pDesc) {
+    HRESULT hr = GetDesc1_Impl(pDesc);
+    if (dxgiTraceEnabled()) {
+      if (SUCCEEDED(hr) && pDesc) dxgiTrace("SwapChain::GetDesc1 -> %ux%u format %d, scaling %d, buffers %u, flags %#x",
+        pDesc->Width, pDesc->Height, pDesc->Format, pDesc->Scaling, pDesc->BufferCount, pDesc->Flags);
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiSwapChain::ResizeBuffers(UINT BufferCount, UINT Width, UINT Height, DXGI_FORMAT NewFormat, UINT SwapChainFlags) {
+    HRESULT hr = ResizeBuffers_Impl(BufferCount, Width, Height, NewFormat, SwapChainFlags);
+    if (dxgiTraceEnabled()) {
+      dxgiTrace("SwapChain::ResizeBuffers(%u buffers, %ux%u, format %d, flags %#x) -> hr %08x", BufferCount, Width, Height, NewFormat, SwapChainFlags, hr);
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiSwapChain::ResizeTarget(const DXGI_MODE_DESC* pNewTargetParameters) {
+    HRESULT hr = ResizeTarget_Impl(pNewTargetParameters);
+    if (dxgiTraceEnabled()) {
+      if (pNewTargetParameters) dxgiTrace("SwapChain::ResizeTarget(%ux%u @ %u/%u) -> hr %08x", pNewTargetParameters->Width, pNewTargetParameters->Height,
+        pNewTargetParameters->RefreshRate.Numerator, pNewTargetParameters->RefreshRate.Denominator, hr);
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiSwapChain::SetFullscreenState(BOOL Fullscreen, IDXGIOutput* pTarget) {
+    HRESULT hr = SetFullscreenState_Impl(Fullscreen, pTarget);
+    if (dxgiTraceEnabled()) {
+      dxgiTrace("SwapChain::SetFullscreenState(%d, target %p) -> hr %08x", Fullscreen, (void*)pTarget, hr);
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE DxgiSwapChain::GetContainingOutput(IDXGIOutput** ppOutput) {
+    HRESULT hr = GetContainingOutput_Impl(ppOutput);
+    if (dxgiTraceEnabled()) {
+      dxgiTrace("SwapChain::GetContainingOutput -> hr %08x", hr);
+    }
+    return hr;
+  }
 }
