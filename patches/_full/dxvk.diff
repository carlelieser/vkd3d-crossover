diff --git a/src/dxgi/dxgi_trace.h b/src/dxgi/dxgi_trace.h
new file mode 100644
index 0000000..78be079
--- /dev/null
+++ b/src/dxgi/dxgi_trace.h
@@ -0,0 +1,37 @@
+#pragma once
+// Diagnostics: DXVK_DXGI_TRACE=1 (or an existing C:\gfx-dxgi.trace file) logs every display/swapchain-related DXGI call made by the application, with its
+// arguments and results, to C:\gfx-dxgi.log (capped at 20000 lines).
+#include <cstdio>
+#include <cstdarg>
+#include <mutex>
+#include "../util/util_env.h"
+
+namespace dxvk {
+
+  inline bool dxgiTraceEnabled() {
+    static int e = -1;
+    if (e < 0) {
+      e = env::getEnvVar("DXVK_DXGI_TRACE") == "1" ? 1 : 0;
+      if (!e) { if (FILE* t = std::fopen("C:\\gfx-dxgi.trace", "r")) { std::fclose(t); e = 1; } }
+    }
+    return e != 0;
+  }
+
+  inline void dxgiTrace(const char* fmt, ...) {
+    if (!dxgiTraceEnabled()) return;
+    static std::mutex m;
+    static FILE* f = nullptr;
+    static unsigned n = 0;
+    std::lock_guard<std::mutex> g(m);
+    if (n++ > 20000) return;
+    if (!f) f = std::fopen("C:\\gfx-dxgi.log", "a");
+    if (!f) return;
+    va_list ap;
+    va_start(ap, fmt);
+    std::vfprintf(f, fmt, ap);
+    va_end(ap);
+    std::fputc('\n', f);
+    std::fflush(f);
+  }
+
+}
