+  HRESULT STDMETHODCALLTYPE DxgiSwapChain::GetDesc(DXGI_SWAP_CHAIN_DESC* pDesc) {
+    HRESULT hr = GetDesc_Impl(pDesc);
+    if (dxgiTraceEnabled()) {
+      if (SUCCEEDED(hr) && pDesc) dxgiTrace("SwapChain::GetDesc -> %ux%u format %d, windowed %d, buffers %u, flags %#x",
+        pDesc->BufferDesc.Width, pDesc->BufferDesc.Height, pDesc->BufferDesc.Format, pDesc->Windowed, pDesc->BufferCount, pDesc->Flags);
