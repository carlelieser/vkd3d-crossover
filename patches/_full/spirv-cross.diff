+// Follows an access chain into a robust buffer: [descriptor index] -> block member -> array element.
+// When the chain indexes the member array, records "element index < element count of the bound range".
+void CompilerMSL::track_robust_buffer_chain(const uint32_t *ops, uint32_t length)
+{
+	uint32_t result_id = ops[1];
+	uint32_t base = ops[2];
+	robust_buffer_chains.erase(result_id);
+
+	RobustBufferChain chain;
+	auto itr = robust_buffer_chains.find(base);
+	if (itr != end(robust_buffer_chains))
+		chain = itr->second;
+	else
+	{
+		auto *var = maybe_get<SPIRVariable>(base);
+		if (!var || !is_robust_buffer_variable(*var) || !buffer_requires_array_length(var->self))
+			return;
+		chain.var_id = var->self;
+		chain.type_id = get_variable_data_type_id(*var);
+		chain.level = is_array(get<SPIRType>(chain.type_id)) ? 0 : 1;
+	}
+
+	for (uint32_t i = 3; i < length && chain.level < 3; i++)
+	{
+		uint32_t index = ops[i];
+		auto &type = get<SPIRType>(chain.type_id);
+
+		if (chain.level == 0)
+		{
+			chain.desc_index = to_unpacked_expression(index);
+			chain.type_id = type.parent_type;
+			chain.level = 1;
+		}
+		else if (chain.level == 1)
+		{
+			auto *c = maybe_get<SPIRConstant>(index);
+			if (type.basetype != SPIRType::Struct || !c || c->scalar() >= type.member_types.size())
+				return;
+			uint32_t member = c->scalar();
+			uint32_t member_type_id = type.member_types[member];
+			auto &member_type = get<SPIRType>(member_type_id);
+			if (!is_array(member_type) || member_type.array.size() != 1 ||
+			    !has_decoration(member_type_id, DecorationArrayStride) ||
+			    !has_member_decoration(type.self, member, DecorationOffset))
+				return; // Nothing indexable to guard.
+			chain.member_offset = type_struct_member_offset(type, member);
+			chain.stride = get_decoration(member_type_id, DecorationArrayStride);
+			if (chain.stride == 0)
+				return;
+			chain.type_id = member_type_id;
+			chain.level = 2;
+		}
+		else
+		{
+			string size = to_buffer_size_expression(chain.var_id);
+			if (!chain.desc_index.empty())
+				size = join(size, "[", chain.desc_index, "]");
+			string count;
+			if (chain.member_offset)
+				count = join("(", size, " > ", chain.member_offset, "u ? (", size, " - ", chain.member_offset, "u) / ",
+				             chain.stride, "u : 0u)");
+			else
+				count = join("(", size, " / ", chain.stride, "u)");
+			chain.guard = join("(uint(", to_unpacked_expression(index), ") < ", count, ")");
+			chain.type_id = type.parent_type;
+			chain.level = 3;
+		}
+	}
+
+	if (chain.level < 3 || !chain.guard.empty())
+		robust_buffer_chains[result_id] = std::move(chain);
+}
