+const std::string *CompilerMSL::get_robust_buffer_guard(uint32_t ptr) const
+{
+	if (!msl_options.robust_buffer_access)
+		return nullptr;
+	auto itr = robust_buffer_chains.find(ptr);
+	if (itr == end(robust_buffer_chains) || itr->second.guard.empty())
+		return nullptr;
+	return &itr->second.guard;
+}
