+// Tessellation stages that MoltenVK links through device buffers (vertex-for-tessellation outputs, tess control
+// inputs/outputs, tess evaluation inputs) cannot share one location between component-packed variables.
+// Give every (location, component) its own slot, location' = location + 256 * component, in the shader's own
+// decorations and in the adjacent-stage interface tables. Component-0 varyings (and IO arrays spanning
+// consecutive locations) keep their numbers, so dynamically indexed ranges stay contiguous. Applied
+// identically in every such stage, so
+// producers and consumers still agree. Tess evaluation outputs (to fragment) use user() names and are untouched.
+void CompilerMSL::remap_tessellation_buffer_io_locations()
+{
+	bool remap_in = is_tesc_shader() || is_tese_shader();
+	bool remap_out = is_tesc_shader() || (get_execution_model() == ExecutionModelVertex && msl_options.vertex_for_tessellation);
+	if (!remap_in && !remap_out)
+		return;
+
+	ir.for_each_typed_id<SPIRVariable>([&](uint32_t, SPIRVariable &var) {
+		bool in = var.storage == StorageClassInput && remap_in;
+		bool out = var.storage == StorageClassOutput && remap_out;
+		if ((!in && !out) || is_builtin_variable(var) || !has_decoration(var.self, DecorationLocation))
+			return;
+		uint32_t locn = get_decoration(var.self, DecorationLocation);
+		uint32_t comp = get_decoration(var.self, DecorationComponent);
+		set_decoration(var.self, DecorationLocation, locn + 256 * comp);
+		unset_decoration(var.self, DecorationComponent);
+	});
+
+	auto remap_maps = [](std::map<LocationComponentPair, MSLShaderInterfaceVariable> &by_loc,
+	                     std::unordered_map<uint32_t, MSLShaderInterfaceVariable> &by_builtin) {
+		std::map<LocationComponentPair, MSLShaderInterfaceVariable> remapped;
+		for (auto &kv : by_loc)
+		{
+			auto v = kv.second;
+			v.location = kv.first.location + 256 * kv.first.component;
+			v.component = 0;
+			remapped[{ v.location, 0 }] = v;
+		}
+		by_loc.swap(remapped);
+		for (auto &kv : by_builtin)
+		{
+			kv.second.location = kv.second.location + 256 * kv.second.component;
+			kv.second.component = 0;
+		}
+	};
+	if (remap_in)
+		remap_maps(inputs_by_location, inputs_by_builtin);
+	if (remap_out)
+		remap_maps(outputs_by_location, outputs_by_builtin);
+}
