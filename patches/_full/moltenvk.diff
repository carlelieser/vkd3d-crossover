+// Samples a 4x4 grid of the presented image every 30 presents and reports to the failure log when
+// only black frames are being presented. Diagnoses "game runs but the screen is black".
+struct MVKPresentProbe {
+	std::mutex lock;
+	id<MTLBuffer> buffer = nil;
+	uint32_t presentCount = 0;
+	bool unavailableLogged = false;
+	bool sawVisible = false;
+	bool blackLogged = false;
+	double created = now();
+	double blackSince = 0;
+	double lastBlackReport = 0;
+
+	static double now() { return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+
+	void update(bool black, uint32_t w, uint32_t h) {
+		std::lock_guard<std::mutex> guard(lock);
+		double t = now();
+		if ( !black ) {
+			if (blackSince && blackLogged) {
+				mvkLogFailure("present", "visible frames again after %.0f s of black (%ux%u)", t - blackSince, w, h);
+			}
+			if ( !sawVisible ) {
+				sawVisible = true;
+				mvkLogFailure("present", "first visible frame %ux%u, %.1f s after swapchain creation", w, h, t - created);
+			}
+			blackSince = 0;
+			blackLogged = false;
+			return;
+		}
+		if ( !blackSince ) { blackSince = t; }
+		if (t - blackSince >= 5.0 && ( !blackLogged || t - lastBlackReport >= 60.0)) {
+			mvkLogFailure("present", "only black frames presented for %.0f s (%ux%u)%s", t - blackSince, w, h,
+						  sawVisible ? "" : "; no visible frame on this swapchain yet");
+			blackLogged = true;
+			lastBlackReport = t;
+		}
+	}
+
+	~MVKPresentProbe() { [buffer release]; }
+};
