     initSurfaceImages(pCreateInfo, imgCnt);		// After initCAMetalLayer()
+
+	if (mvkFailureLogEnabled()) {
+		const char* cs = "other";
+		switch (pCreateInfo->imageColorSpace) {
+			case VK_COLOR_SPACE_SRGB_NONLINEAR_KHR:          cs = "sRGB"; break;
+			case VK_COLOR_SPACE_HDR10_ST2084_EXT:            cs = "HDR10-PQ"; break;
+			case VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT:    cs = "scRGB-linear"; break;
+			case VK_COLOR_SPACE_EXTENDED_SRGB_NONLINEAR_EXT: cs = "scRGB-nonlinear"; break;
+			case VK_COLOR_SPACE_BT2020_LINEAR_EXT:           cs = "BT2020-linear"; break;
+			case VK_COLOR_SPACE_PASS_THROUGH_EXT:            cs = "pass-through"; break;
+			default: break;
+		}
+		const char* fmt = "other";
+		switch (pCreateInfo->imageFormat) {
+			case VK_FORMAT_B8G8R8A8_UNORM:            fmt = "BGRA8"; break;
+			case VK_FORMAT_B8G8R8A8_SRGB:             fmt = "BGRA8-sRGB"; break;
+			case VK_FORMAT_R8G8B8A8_UNORM:            fmt = "RGBA8"; break;
+			case VK_FORMAT_R8G8B8A8_SRGB:             fmt = "RGBA8-sRGB"; break;
+			case VK_FORMAT_A2B10G10R10_UNORM_PACK32:  fmt = "RGB10A2"; break;
+			case VK_FORMAT_A2R10G10B10_UNORM_PACK32:  fmt = "BGR10A2"; break;
+			case VK_FORMAT_R16G16B16A16_SFLOAT:       fmt = "RGBA16F"; break;
+			default: break;
+		}
+		const char* layerCS = "none";
+		bool edr = false;
+		MTLPixelFormat layerFmt = MTLPixelFormatInvalid;
+		@autoreleasepool {
+			auto* layer = getCAMetalLayer();
+			if (layer) {
+				CGColorSpaceRef lcs = layer.colorspace;
+				CFStringRef name = lcs ? CGColorSpaceGetName(lcs) : nullptr;
+				static char buf[128];
+				if (name && CFStringGetCString(name, buf, sizeof(buf), kCFStringEncodingUTF8)) { layerCS = buf; }
+				edr = layer.wantsExtendedDynamicRangeContent;
+				layerFmt = layer.pixelFormat;
+			}
+		}
+		mvkLogFailure("swapchain", "%s %s swapchain %ux%u, %u images, present mode %d; layer %s, EDR %s, MTLPixelFormat %lu%s", fmt, cs,
+					  pCreateInfo->imageExtent.width, pCreateInfo->imageExtent.height, imgCnt, pCreateInfo->presentMode,
+					  layerCS, edr ? "on" : "off", (unsigned long)layerFmt,
+					  getConfigurationResult() == VK_SUCCESS ? "" : " -- CREATION FAILED");
+	}
 }
 
