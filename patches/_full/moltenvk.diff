+	blit.label = @"MVK black-frame probe";
+	for (uint32_t j = 0; j < 4; j++) {
+		for (uint32_t i = 0; i < 4; i++) {
+			[blit copyFromTexture: mtlTexture
+					  sourceSlice: 0
+					  sourceLevel: 0
+					 sourceOrigin: MTLOriginMake(w * (2 * i + 1) / 8, h * (2 * j + 1) / 8, 0)
+					   sourceSize: MTLSizeMake(1, 1, 1)
+						 toBuffer: probe->buffer
