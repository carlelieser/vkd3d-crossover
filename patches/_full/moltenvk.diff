+#pragma mark -
+#pragma mark Failure log
+
+#include <fcntl.h>
+#include <unistd.h>
+#include <mutex>
+#include <unordered_map>
+#include <chrono>
+#include <ctime>
+#include <sys/time.h>
+
+namespace {
+
+struct MVKFailureLog {
+	std::mutex lock;
+	int fd = -1;
+	struct Entry { uint64_t count = 0; uint64_t reported = 0; };
+	std::unordered_map<std::string, Entry> entries;
+	std::chrono::steady_clock::time_point lastSummary = std::chrono::steady_clock::now();
+
+	MVKFailureLog() {
+		const char* env = getenv("MVK_FAILURE_LOG");
+		if (env && (!strcmp(env, "0") || !strcasecmp(env, "off"))) { return; }
+		std::string path;
+		if (env && *env) {
+			path = env;
+		} else if (const char* pfx = getenv("WINEPREFIX"); pfx && *pfx) {
+			path = std::string(pfx) + "/drive_c/gfx-failures.log";
+		} else if (const char* home = getenv("HOME"); home && *home) {
+			path = std::string(home) + "/Library/Logs/gfx-failures.log";
+		} else {
+			return;
+		}
+		fd = open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644);
+		if (fd >= 0) { writeLine("process", "MoltenVK loaded (%s)", getprogname()); }
+	}
+
+	// Collapses numbers and hex so the same failure with different handles or sizes dedups to one key.
+	static std::string makeKey(const char* category, const char* msg) {
+		std::string key(category);
+		key += ':';
+		for (const char* p = msg; *p && key.size() < 240; p++) {
+			if (p[0] == '0' && p[1] == 'x') { key += '#'; p += 2; while (isxdigit(*p)) { p++; } p--; continue; }
+			if (isdigit(*p)) { key += '#'; while (isdigit(p[1])) { p++; } continue; }
+			if (*p == '\n') { break; }
+			key += *p;
+		}
+		return key;
+	}
+
+	void writeRaw(const std::string& s) { if (fd >= 0) { (void)!write(fd, s.data(), s.size()); } }
+
+	void writeLine(const char* category, const char* fmt, ...) __attribute__((format(printf, 3, 4))) {
+		char msg[512];
+		va_list args;
+		va_start(args, fmt);
+		vsnprintf(msg, sizeof(msg), fmt, args);
+		va_end(args);
+		writeRaw(prefix(category) + msg + "\n");
+	}
+
+	static std::string prefix(const char* category) {
+		struct timeval tv; gettimeofday(&tv, nullptr);
+		struct tm tmv; localtime_r(&tv.tv_sec, &tmv);
+		char buf[96];
+		snprintf(buf, sizeof(buf), "%02d:%02d:%02d.%03d mvk[%d] %s: ", tmv.tm_hour, tmv.tm_min, tmv.tm_sec,
+				 (int)(tv.tv_usec / 1000), (int)getpid(), category);
+		return buf;
+	}
+
+	// Writes the message, keeping only the first lines of long multi-line messages (e.g. MSL compiler output).
+	void writeMessage(const char* category, const char* msg, uint64_t occurrence) {
+		std::string out = prefix(category);
+		if (occurrence > 1) { out += "[#" + std::to_string(occurrence) + "] "; }
+		int lines = 0;
+		for (const char* p = msg; *p; p++) {
+			if (*p == '\n') {
+				if (!p[1]) { break; }
+				if (++lines >= 8 || out.size() > 1500) { out += "\n    ..."; break; }
+				out += "\n    ";
+				continue;
+			}
+			out += *p;
+		}
+		out += '\n';
+		writeRaw(out);
+	}
+
+	void flushSummaryLocked(bool force) {
+		auto now = std::chrono::steady_clock::now();
+		if (!force && now - lastSummary < std::chrono::seconds(10)) { return; }
+		lastSummary = now;
+		for (auto& [key, e] : entries) {
+			if (e.count > e.reported) {
+				writeLine("repeat", "+%llu more: %s", (unsigned long long)(e.count - e.reported), key.c_str());
+				e.reported = e.count;
+			}
+		}
+	}
+
+	void log(const char* category, const char* msg) {
+		if (fd < 0) { return; }
+		std::lock_guard<std::mutex> guard(lock);
+		auto& e = entries[makeKey(category, msg)];
+		e.count++;
+		if (e.count <= 3) {
+			writeMessage(category, msg, e.count);
+			e.reported = e.count;
+		}
+		flushSummaryLocked(false);
+	}
+};
+
+MVKFailureLog& mvkFailureLogInstance() {
+	static MVKFailureLog* inst = [] {
+		auto* l = new MVKFailureLog();	// Leaked on purpose: usable from completion handlers during teardown.
+		atexit([] { auto& f = mvkFailureLogInstance(); std::lock_guard<std::mutex> g(f.lock); f.flushSummaryLocked(true); });
+		return l;
+	}();
+	return *inst;
+}
+
+}
+
+bool mvkFailureLogEnabled() { return mvkFailureLogInstance().fd >= 0; }
+
+void mvkLogFailure(const char* category, const char* format, ...) {
+	auto& fl = mvkFailureLogInstance();
+	if (fl.fd < 0) { return; }
+	char buf[4096];
+	va_list args;
+	va_start(args, format);
+	vsnprintf(buf, sizeof(buf), format, args);
+	va_end(args);
+	fl.log(category, buf);
+}
diff --git a/MoltenVK/MoltenVK/Utility/MVKBinaryArchive.h b/MoltenVK/MoltenVK/Utility/MVKBinaryArchive.h
new file mode 100644
index 0000000..d35ec5d
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKBinaryArchive.h
@@ -0,0 +1,294 @@
+/*
+ * MVKBinaryArchive.h — persistent Metal pipeline cache (MTLBinaryArchive) for MoltenVK under Wine.
+ *
+ * Metal's implicit shader cache is not written by Wine processes, so every launch recompiled every pipeline and the game
+ * stalled whenever it needed a pipeline compiled now (hundreds of ms each). This keeps a set of archive segments per
+ * program in ~/Library/Caches/MoltenVK/archives/<program>-<gpu>.<n>.metalarchive and searches all of them.
+ *
+ * - Lookup: fail-on-miss pipeline creation against all segments. On a miss the descriptor's functions are compiled into
+ *   the current (in-memory) segment, then the pipeline is created normally and finds them there.
+ * - Saving: once a minute (or after 250 additions, since Metal cannot serialize very large archives), the current segment is retired and replaced by a fresh one;
+ *   a background thread writes the retired one to disk once its in-flight additions have finished. No lock is ever held
+ *   across a Metal call and pipeline creation never waits on a save. (Earlier versions saved under a lock, which froze
+ *   Pragmata mid-cutscene, and then only at exit, which Pragmata's shutdown never reaches.)
+ * - Also a best-effort save at exit (MVK_BINARY_ARCHIVE_SAVE_SEC overrides the interval, for testing).
+ * - Old/unloadable segments are skipped and deleted; at most kMaxSegments are kept (oldest dropped).
+ * STATUS: experimental, OFF by default (MVK_BINARY_ARCHIVE=1 enables). The premise turned out wrong — Metal's implicit
+ * cache IS written for Wine processes, under DARWIN_USER_CACHE_DIR/com.codeweavers.CrossOver.wineloader/com.apple.metal —
+ * and on macOS 27 Metal fails to serialize large archives (MDB_MAP_FULL) and hung indefinitely loading a 21 MB archive
+ * it had written, even in a native test program.
+ */
+#pragma once
+
+#import <Metal/Metal.h>
+#include "MVKBaseObject.h"
+#include <mutex>
+#include <atomic>
+#include <memory>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <thread>
+#include <chrono>
+#include <stdlib.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <string.h>
+
+class MVKBinaryArchiveCache {
+	struct Segment {
+		id<MTLBinaryArchive> archive = nil;
+		std::atomic<int> inflight{0};
+		~Segment() { [archive release]; }
+	};
+
+public:
+	static MVKBinaryArchiveCache& get(id<MTLDevice> dev) {
+		static MVKBinaryArchiveCache* c = new MVKBinaryArchiveCache(dev);
+		return *c;
+	}
+
+	id<MTLRenderPipelineState> render(MTLRenderPipelineDescriptor* d) {
+		if ( !_enabled ) { return nil; }
+		NSArray* all = nil; std::shared_ptr<Segment> cur = snapshot(&all);
+		if ( !cur ) { return nil; }
+		d.binaryArchives = all;
+		NSError* err = nil;
+		id<MTLRenderPipelineState> ps = [_dev newRenderPipelineStateWithDescriptor: d options: MTLPipelineOptionFailOnBinaryArchiveMiss
+																		 reflection: nil error: &err];
+		[all release];
+		if (ps) { _hits++; return ps; }
+		bool ok;
+		{ Inflight g(cur); ok = [cur->archive addRenderPipelineFunctionsWithDescriptor: d error: &err]; }
+		if ( !ok ) { noteFailure("render", err); d.binaryArchives = nil; return nil; }
+		d.binaryArchives = @[cur->archive];
+		noteAdded();
+		return nil;
+	}
+
+	id<MTLComputePipelineState> compute(MTLComputePipelineDescriptor* d) {
+		if ( !_enabled ) { return nil; }
+		NSArray* all = nil; std::shared_ptr<Segment> cur = snapshot(&all);
+		if ( !cur ) { return nil; }
+		d.binaryArchives = all;
+		NSError* err = nil;
+		id<MTLComputePipelineState> ps = [_dev newComputePipelineStateWithDescriptor: d options: MTLPipelineOptionFailOnBinaryArchiveMiss
+																		  reflection: nil error: &err];
+		[all release];
+		if (ps) { _hits++; return ps; }
+		bool ok;
+		{ Inflight g(cur); ok = [cur->archive addComputePipelineFunctionsWithDescriptor: d error: &err]; }
+		if ( !ok ) { noteFailure("compute", err); d.binaryArchives = nil; return nil; }
+		d.binaryArchives = @[cur->archive];
+		noteAdded();
+		return nil;
+	}
+
+	id<MTLRenderPipelineState> mesh(id meshDesc) API_AVAILABLE(macos(14.0), ios(17.0)) {
+		if ( !_enabled ) { return nil; }
+		MTLMeshRenderPipelineDescriptor* d = (MTLMeshRenderPipelineDescriptor*)meshDesc;
+		NSArray* all = nil; std::shared_ptr<Segment> cur = snapshot(&all);
+		if ( !cur ) { return nil; }
+		d.binaryArchives = all;
+		NSError* err = nil;
+		id<MTLRenderPipelineState> ps = [_dev newRenderPipelineStateWithMeshDescriptor: d options: MTLPipelineOptionFailOnBinaryArchiveMiss
+																			reflection: nil error: &err];
+		[all release];
+		if (ps) { _hits++; return ps; }
+		bool ok;
+		{ Inflight g(cur); ok = [cur->archive addMeshRenderPipelineFunctionsWithDescriptor: d error: &err]; }
+		if ( !ok ) { noteFailure("mesh", err); d.binaryArchives = nil; return nil; }
+		d.binaryArchives = @[cur->archive];
+		noteAdded();
+		return nil;
+	}
+
+private:
+	static constexpr int kMaxSegments = 128;
+	static constexpr uint32_t kMaxPipelinesPerSegment = 250;	// Metal's serializer fails (MDB_MAP_FULL) on very large archives
+	static constexpr int kSaveIntervalSec = 60;
+
+	struct Inflight {
+		std::shared_ptr<Segment> s;
+		Inflight(std::shared_ptr<Segment> seg) : s(std::move(seg)) { s->inflight++; }
+		~Inflight() { s->inflight--; }
+	};
+
+	MVKBinaryArchiveCache(id<MTLDevice> dev) : _dev([dev retain]) {
+		const char* e = getenv("MVK_BINARY_ARCHIVE");
+		if ( !(e && e[0] == '1') ) { return; }		// experimental, off by default (see header)
+		if (@available(macOS 11.0, iOS 14.0, *)) {} else { return; }
+		const char* home = getenv("HOME");
+		if ( !home || !*home ) { return; }
+		_dir = std::string(home) + "/Library/Caches/MoltenVK";
+		mkdir(_dir.c_str(), 0755);
+		_dir += "/archives";
+		mkdir(_dir.c_str(), 0755);
+		std::string prog = getprogname() ? getprogname() : "app";
+		for (auto& ch : prog) { if (ch == '/' || ch == '\\' || ch == ' ') { ch = '_'; } }
+		char base[256];
+		snprintf(base, sizeof(base), "%s-%llx.", prog.c_str(), (unsigned long long)dev.registryID);
+		_base = base;
+
+		cleanStaleTempFiles();
+		loadSegments();
+		_current = newSegment();
+		_enabled = _current != nullptr;
+		_lastSave = time(nullptr);
+		if (const char* si = getenv("MVK_BINARY_ARCHIVE_SAVE_SEC")) { _saveInterval = std::max(1, atoi(si)); }
+		if (_enabled) { s_instance = this; atexit([]() { if (s_instance) { s_instance->saveAtExit(); } }); }
+	}
+
+	// Best effort: some programs' shutdown never runs atexit handlers; the periodic saves cover those.
+	void saveAtExit() {
+		if (_pending.load() == 0 || _saving.exchange(true)) { return; }
+		std::shared_ptr<Segment> cur;
+		{ std::lock_guard<std::mutex> g(_lock); cur = _current; }
+		if (cur && cur->inflight.load() == 0) { saveSegment(cur, _pending.exchange(0)); }
+	}
+
+	std::shared_ptr<Segment> newSegment() {
+		@autoreleasepool {
+			MTLBinaryArchiveDescriptor* ad = [[MTLBinaryArchiveDescriptor new] autorelease];
+			NSError* err = nil;
+			id<MTLBinaryArchive> a = [_dev newBinaryArchiveWithDescriptor: ad error: &err];
+			if ( !a ) { return nullptr; }
+			auto s = std::make_shared<Segment>();
+			s->archive = a;
+			return s;
+		}
+	}
+
+	// Returns the current segment and (retained) an array of every archive to search.
+	std::shared_ptr<Segment> snapshot(NSArray** all) {
+		std::lock_guard<std::mutex> g(_lock);		// guards pointers only; never held across Metal calls
+		if ( !_current ) { return nullptr; }
+		NSMutableArray* a = [[NSMutableArray alloc] initWithCapacity: _loaded.size() + 1];
+		[a addObject: _current->archive];
+		for (auto& s : _loaded) { [a addObject: s->archive]; }
+		*all = a;
+		return _current;
+	}
+
+	void noteFailure(const char* kind, NSError* err) {
+		if (_failures++ < 8) {
+			mvkLogFailure("binary-archive", "could not add a %s pipeline to the archive: %s", kind,
+						  err ? err.localizedDescription.UTF8String : "?");
+		}
+	}
+
+	void noteAdded() {
+		_added++;
+		_pending++;
+		time_t now = time(nullptr);
+		if ((now - _lastSave.load() < _saveInterval && _pending.load() < kMaxPipelinesPerSegment) || _saving.exchange(true)) { return; }
+		_lastSave = now;
+		std::shared_ptr<Segment> retired;
+		{
+			std::lock_guard<std::mutex> g(_lock);
+			auto fresh = newSegment();
+			if ( !fresh ) { _saving = false; return; }
+			retired = _current;
+			_current = fresh;
+			_loaded.insert(_loaded.begin(), retired);	// keep searching it
+		}
+		uint32_t n = _pending.exchange(0);
+		dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_BACKGROUND, 0), ^{
+			// Wait for additions that were already in progress on the retired segment (bounded).
+			for (int i = 0; i < 3000 && retired->inflight.load() > 0; i++) { std::this_thread::sleep_for(std::chrono::milliseconds(10)); }
+			if (retired->inflight.load() == 0) { saveSegment(retired, n); }
+			_saving = false;
+		});
+	}
+
+	void saveSegment(const std::shared_ptr<Segment>& s, uint32_t count) {
+		@autoreleasepool {
+			char name[64];
+			snprintf(name, sizeof(name), "%08lx%04x.metalarchive", (unsigned long)time(nullptr), (unsigned)(_seq++ & 0xffff));
+			std::string path = _dir + "/" + _base + name, tmp = path + ".tmp";
+			NSError* err = nil;
+			if ([s->archive serializeToURL: [NSURL fileURLWithPath: @(tmp.c_str())] error: &err] && rename(tmp.c_str(), path.c_str()) == 0) {
+				struct stat st; stat(path.c_str(), &st);
+				mvkLogFailure("binary-archive", "saved segment %s (%.1f MB, %u pipelines; %u added and %u loaded from archives this run)",
+							  name, st.st_size / 1e6, count, _added.load(), _hits.load());
+				pruneSegments();
+			} else {
+				unlink(tmp.c_str());
+				mvkLogFailure("binary-archive", "could not save %s: %s", path.c_str(), err ? err.localizedDescription.UTF8String : "?");
+			}
+		}
+	}
+
+	std::vector<std::string> segmentFiles() {
+		std::vector<std::string> v;
+		if (DIR* dd = opendir(_dir.c_str())) {
+			while (struct dirent* de = readdir(dd)) {
+				std::string n = de->d_name;
+				if (n.compare(0, _base.size(), _base) == 0 && n.size() > 13 && n.compare(n.size() - 13, 13, ".metalarchive") == 0) {
+					v.push_back(n);
+				}
+			}
+			closedir(dd);
+		}
+		std::sort(v.begin(), v.end());		// oldest first (names start with the save time)
+		return v;
+	}
+
+	void loadSegments() {
+		auto files = segmentFiles();
+		double mb = 0; int ok = 0;
+		for (auto it = files.rbegin(); it != files.rend(); ++it) {		// newest first
+			std::string path = _dir + "/" + *it;
+			@autoreleasepool {
+				MTLBinaryArchiveDescriptor* ad = [[MTLBinaryArchiveDescriptor new] autorelease];
+				ad.url = [NSURL fileURLWithPath: @(path.c_str())];
+				NSError* err = nil;
+				id<MTLBinaryArchive> a = (ok < kMaxSegments) ? [_dev newBinaryArchiveWithDescriptor: ad error: &err] : nil;
+				if ( !a ) { unlink(path.c_str()); continue; }		// unreadable (OS/driver update) or over the cap
+				auto s = std::make_shared<Segment>();
+				s->archive = a;
+				_loaded.push_back(s);
+				struct stat st; if (stat(path.c_str(), &st) == 0) { mb += st.st_size / 1e6; }
+				ok++;
+			}
+		}
+		if (ok) { mvkLogFailure("binary-archive", "loaded %d pipeline archive segment(s) for %s (%.1f MB)", ok, _base.c_str(), mb); }
+	}
+
+	void pruneSegments() {
+		auto files = segmentFiles();
+		for (size_t i = 0; i + kMaxSegments < files.size(); i++) { unlink((_dir + "/" + files[i]).c_str()); }
+	}
+
+	void cleanStaleTempFiles() {
+		// Metal's serializer writes temporary "<UUID>.metallib" files, and an interrupted save leaves "*.tmp".
+		if (DIR* dd = opendir(_dir.c_str())) {
+			while (struct dirent* de = readdir(dd)) {
+				const char* n = de->d_name;
+				size_t len = strlen(n);
+				bool uuidLib = len == 36 + 9 && strcmp(n + 36, ".metallib") == 0 && n[8] == '-' && n[13] == '-';
+				bool tmp = len > 4 && strcmp(n + len - 4, ".tmp") == 0;
+				if (uuidLib || tmp) {
+					std::string f = _dir + "/" + n;
+					struct stat st;
+					if (stat(f.c_str(), &st) == 0 && time(nullptr) - st.st_mtime > 600) { unlink(f.c_str()); }
+				}
+			}
+			closedir(dd);
+		}
+	}
+
+	id<MTLDevice> _dev;
+	bool _enabled = false;
+	std::string _dir, _base;
+	std::mutex _lock;
+	std::shared_ptr<Segment> _current;
+	std::vector<std::shared_ptr<Segment>> _loaded;
+	std::atomic<uint32_t> _added{0}, _hits{0}, _failures{0}, _pending{0}, _seq{0};
+	std::atomic<bool> _saving{false};
+	std::atomic<time_t> _lastSave{0};
+	int _saveInterval = kSaveIntervalSec;
+	static inline MVKBinaryArchiveCache* s_instance = nullptr;
+};
diff --git a/MoltenVK/MoltenVK/Utility/MVKDebugBuffer.h b/MoltenVK/MoltenVK/Utility/MVKDebugBuffer.h
new file mode 100644
index 0000000..cd3398d
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKDebugBuffer.h
@@ -0,0 +1,77 @@
+/*
+ * MVKDebugBuffer.h
+ *
+ * Diagnostics only (MVK_DEBUG_BUFFER=1): a shared buffer bound at Metal buffer index 20 for every fragment and
+ * compute pipeline, so hand-instrumented shaders (MVK_MSL_OVERRIDE_DIR) can record values ("GPU printf").
+ * Layout (uint32 words): [0] record counter, records of 64 words from word 64. A shader reserves a record with
+ * atomic_fetch_add on word 0 and writes it only if the slot is below kMaxRecords. Every 2 s (on present) the
+ * recorded words are appended to $WINEPREFIX/drive_c/gfx-dbg.bin as: "MVKDBG01", uint32 count, count * 64 words,
+ * and the counter is reset.
+ */
+
+#pragma once
+
+#import <Metal/Metal.h>
+#include <mutex>
+#include <chrono>
+#include <string>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <unistd.h>
+
+class MVKDebugBuffer {
+public:
+	static constexpr uint32_t kIndex = 20;
+	static constexpr uint32_t kRecordWords = 64;
+	static constexpr uint32_t kMaxRecords = 8192;
+	static constexpr uint32_t kHeaderWords = 64;
+
+	static MVKDebugBuffer& get() { static MVKDebugBuffer* d = new MVKDebugBuffer(); return *d; }
+
+	bool enabled() const { return _enabled; }
+
+	id<MTLBuffer> buffer(id<MTLDevice> dev) {
+		if ( !_enabled ) { return nil; }
+		std::lock_guard<std::mutex> lock(_lock);
+		if ( !_buffer ) {
+			NSUInteger len = (kHeaderWords + kMaxRecords * kRecordWords) * 4;
+			_buffer = [dev newBufferWithLength: len options: MTLResourceStorageModeShared];
+			memset(_buffer.contents, 0, len);
+		}
+		return _buffer;
+	}
+
+	void onPresent() {
+		if ( !_enabled || !_buffer ) { return; }
+		double t = std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+		std::lock_guard<std::mutex> lock(_lock);
+		if (t - _lastDump < 2.0 || _dumps >= 400) { return; }
+		_lastDump = t;
+		volatile uint32_t* w = (volatile uint32_t*)_buffer.contents;
+		uint32_t count = w[0];
+		if ( !count ) { return; }
+		if (count > kMaxRecords) { count = kMaxRecords; }
+		std::string path;
+		if (const char* pfx = getenv("WINEPREFIX")) { path = std::string(pfx) + "/drive_c/gfx-dbg.bin"; }
+		else { path = "/tmp/gfx-dbg.bin"; }
+		int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_APPEND, 0644);
+		if (fd >= 0) {
+			ssize_t r = write(fd, "MVKDBG01", 8);
+			r = write(fd, &count, 4);
+			r = write(fd, (const void*)(w + kHeaderWords), (size_t)count * kRecordWords * 4);
+			(void)r;
+			close(fd);
+		}
+		w[0] = 0;
+		_dumps++;
+	}
+
+private:
+	MVKDebugBuffer() { const char* e = getenv("MVK_DEBUG_BUFFER"); const char* o = getenv("MVK_MSL_OVERRIDE_DIR"); _enabled = (e && e[0] == '1') || (o && *o && !(e && e[0] == '0')); }
+	bool _enabled = false;
+	std::mutex _lock;
+	id<MTLBuffer> _buffer = nil;
+	double _lastDump = 0;
+	int _dumps = 0;
+};
diff --git a/MoltenVK/MoltenVK/Utility/MVKDeferredPSO.h b/MoltenVK/MoltenVK/Utility/MVKDeferredPSO.h
new file mode 100644
index 0000000..9143a29
--- /dev/null
+++ b/MoltenVK/MoltenVK/Utility/MVKDeferredPSO.h
@@ -0,0 +1,154 @@
+/*
+ * MVKDeferredPSO.h — deferred Metal render pipeline compilation.
+ *
+ * RE Engine (and other D3D12 games) re-create their whole pipeline set (~48k for Pragmata) on background threads every
+ * launch. On Windows a driver-cache hit costs a few hundredths of a ms; through vkd3d -> MoltenVK -> Metal it cost ~16 ms
+ * per pipeline (~11 ms of it the Metal render pipeline compile), so the warm-up never finished and the game stalled for
+ * 1-3 s whenever it needed a pipeline still queued.
+ *
+ * Here vkCreateGraphicsPipelines does the CPU work (shader conversion, libraries, descriptor) and hands the Metal
+ * pipeline compile to this scheduler, which keeps only a few compiles in flight. The first draw that needs a pipeline
+ * that is still queued submits it immediately (ahead of the queue) and waits for it alone; while any draw is waiting,
+ * no new background compiles are submitted, and shader-library compiles on the game's threads pause (yieldToUrgent,
+ * at most 50 ms each), so Metal's compiler service works on the urgent ones first.
+ * MVK_DEFERRED_PSO=0 disables; MVK_DEFERRED_PSO_INFLIGHT sets the background concurrency (default 4).
+ */
+#pragma once
+
+#import <Metal/Metal.h>
+#include "MVKBaseObject.h"
+#include "MVKFrameStats.h"
+#include <mutex>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <vector>
+#include <chrono>
+#include <stdlib.h>
+
+struct MVKDeferredRenderPSO {
+	MTLRenderPipelineDescriptor* desc = nil;		// retained copy
+	id<MTLRenderPipelineState> state = nil;		// retained when done
+	std::mutex lock;
+	std::condition_variable done;
+	int status = 0;								// 0 queued, 1 submitted, 2 done (guarded: 0->1 by scheduler lock, 1->2 by lock)
+	uint64_t submitNs = 0;
+	~MVKDeferredRenderPSO() { [desc release]; [state release]; }
+};
+
+class MVKDeferredPSOScheduler {
+public:
+	static bool enabled() {
+		static const bool e = !(getenv("MVK_DEFERRED_PSO") && getenv("MVK_DEFERRED_PSO")[0] == '0');
+		return e;
+	}
+
+	static MVKDeferredPSOScheduler& get(id<MTLDevice> dev) {
+		static MVKDeferredPSOScheduler* s = new MVKDeferredPSOScheduler(dev);
+		return *s;
+	}
+
+	/** Queues a compile of a copy of the descriptor. */
+	std::shared_ptr<MVKDeferredRenderPSO> enqueue(MTLRenderPipelineDescriptor* desc) {
+		auto job = std::make_shared<MVKDeferredRenderPSO>();
+		job->desc = [desc copy];
+		std::vector<std::shared_ptr<MVKDeferredRenderPSO>> submit;
+		{
+			std::lock_guard<std::mutex> g(_lock);
+			_queue.push_back(job);
+			takeLocked(submit);
+		}
+		for (auto& j : submit) { submitJob(j); }
+		return job;
+	}
+
+	/**
+	 * Called before other Metal compiles (shader libraries, synchronous pipelines) on the game's threads: while a draw is
+	 * waiting on a pipeline, waits (at most maxWaitMs) so Metal's compiler service works on the urgent one first.
+	 */
+	void yieldToUrgent(int maxWaitMs = 50) {
+		std::unique_lock<std::mutex> g(_lock);
+		if (_waiting == 0) { return; }
+		_urgentClear.wait_for(g, std::chrono::milliseconds(maxWaitMs), [&] { return _waiting == 0; });
+	}
+
+	/** Returns the compiled state (retained +1 for the caller), compiling it now if it is still queued. */
+	id<MTLRenderPipelineState> wait(const std::shared_ptr<MVKDeferredRenderPSO>& job) {
+		bool urgent = false;
+		{
+			std::lock_guard<std::mutex> g(_lock);
+			if (job->status == 0) { job->status = 1; _inflight++; urgent = true; }
+			_waiting++;		// pauses background submissions until every waiting draw has its pipeline
+		}
+		uint64_t t0 = mvkFrameStatsEnabled() ? mvkFrameStatsNowNs() : 0;
+		if (urgent) { submitJob(job, /*alreadyMarked*/ true); }
+		{
+			std::unique_lock<std::mutex> lk(job->lock);
+			job->done.wait(lk, [&] { return job->status == 2; });
+		}
+		std::vector<std::shared_ptr<MVKDeferredRenderPSO>> resume;
+		{
+			std::lock_guard<std::mutex> g(_lock);
+			_waiting--;
+			takeLocked(resume);
+		}
+		_urgentClear.notify_all();
+		for (auto& j : resume) { submitJob(j); }
+		if (t0) {
+			uint64_t waited = mvkFrameStatsNowNs() - t0;
+			if (waited > 100000) { mvkFrameStatNs[kMVKStatPSOWait] += waited; mvkFrameStatCount[kMVKStatPSOWait]++; }
+		}
+		return [job->state retain];
+	}
+
+private:
+	MVKDeferredPSOScheduler(id<MTLDevice> dev) : _dev([dev retain]) {
+		if (const char* v = getenv("MVK_DEFERRED_PSO_INFLIGHT")) { _maxInflight = std::max(1, atoi(v)); }
+	}
+
+	void takeLocked(std::vector<std::shared_ptr<MVKDeferredRenderPSO>>& out) {
+		while (_waiting == 0 && _inflight < _maxInflight && !_queue.empty()) {
+			auto j = _queue.front().lock();
+			_queue.pop_front();
+			if ( !j || j->status != 0 ) { continue; }		// pipeline destroyed, or already submitted urgently
+			j->status = 1;
+			_inflight++;
+			out.push_back(j);
+		}
+	}
+
+	// Called without the scheduler lock held (Metal may run the completion handler on this thread).
+	void submitJob(std::shared_ptr<MVKDeferredRenderPSO> job, bool alreadyMarked = true) {
+		job->submitNs = mvkFrameStatsEnabled() ? mvkFrameStatsNowNs() : 0;
+		[_dev newRenderPipelineStateWithDescriptor: job->desc
+								 completionHandler: ^(id<MTLRenderPipelineState> ps, NSError* error) {
+			if ( !ps ) {
+				mvkLogFailure("deferred-pso", "render pipeline compile failed: %s", error ? error.localizedDescription.UTF8String : "?");
+			}
+			if (job->submitNs) { mvkFrameStatNs[kMVKStatRenderPSO] += mvkFrameStatsNowNs() - job->submitNs; mvkFrameStatCount[kMVKStatRenderPSO]++; }
+			{
+				std::lock_guard<std::mutex> g(job->lock);
+				job->state = [ps retain];
+				job->status = 2;
+				[job->desc release];
+				job->desc = nil;
+			}
+			job->done.notify_all();
+			std::vector<std::shared_ptr<MVKDeferredRenderPSO>> next;
+			{
+				std::lock_guard<std::mutex> g(_lock);
+				_inflight--;
+				takeLocked(next);
+			}
+			for (auto& j : next) { submitJob(j); }
+		}];
+	}
+
+	id<MTLDevice> _dev;
+	std::mutex _lock;
+	std::deque<std::weak_ptr<MVKDeferredRenderPSO>> _queue;
+	int _inflight = 0;
+	int _waiting = 0;		// draws currently blocked on a pipeline
+	std::condition_variable _urgentClear;
+	int _maxInflight = 4;
+};
