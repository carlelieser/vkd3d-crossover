+		if (verbose) {
+			// Raw value of the sample at (3/8, 3/8) of the drawable, as presented.
+			if (kind == 2) {
+				uint16_t c[4]; memcpy(c, d + 5 * 8, 8);
+				mvkLogFailure("present-sample", "%ux%u RGBA16F %04x %04x %04x %04x", w, h, c[0], c[1], c[2], c[3]);
