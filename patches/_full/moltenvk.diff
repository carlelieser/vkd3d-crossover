+
+void MVKEmulatedPipelineStatisticsQueryPool::encodeCopyResults(MVKCommandEncoder* cmdEncoder, uint32_t firstQuery, uint32_t queryCount,
+                                                               MVKBuffer* destBuffer, VkDeviceSize destOffset, VkDeviceSize stride,
+                                                               VkQueryResultFlags flags) {
+	if (queryCount == 0) { return; }
+	// Build the destination contents on the CPU (zeros, plus availability if requested) and blit them in.
+	bool is64 = mvkIsAnyFlagEnabled(flags, VK_QUERY_RESULT_64_BIT);
+	bool withAvail = mvkIsAnyFlagEnabled(flags, VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+	bool partial = mvkIsAnyFlagEnabled(flags, VK_QUERY_RESULT_PARTIAL_BIT);
+	size_t elemSize = is64 ? sizeof(uint64_t) : sizeof(uint32_t);
+	size_t perQuery = (_queryElementCount + (withAvail ? 1 : 0)) * elemSize;
+	NSUInteger total = (NSUInteger)((queryCount - 1) * stride + perQuery);
+	const MVKMTLBufferAllocation* tmp = cmdEncoder->getTempMTLBuffer(total);
+	uint8_t* p = (uint8_t*)tmp->getContents();
+	memset(p, 0, total);
+	_availabilityLock.lock();
+	for (uint32_t i = 0; i < queryCount; i++) {
+		bool avail = _availability[firstQuery + i] == Available;
+		uint8_t* q = p + i * stride;
+		if (withAvail) {
+			if (is64) { ((uint64_t*)q)[_queryElementCount] = avail; } else { ((uint32_t*)q)[_queryElementCount] = avail; }
+		}
+		(void)partial;
+	}
+	_availabilityLock.unlock();
+	id<MTLBlitCommandEncoder> blit = cmdEncoder->getMTLBlitEncoder(kMVKCommandUseCopyQueryPoolResults);
+	[blit copyFromBuffer: tmp->_mtlBuffer sourceOffset: tmp->_offset
+	            toBuffer: destBuffer->getMTLBuffer() destinationOffset: destBuffer->getMTLBufferOffset() + destOffset
+	                size: total];
+}
