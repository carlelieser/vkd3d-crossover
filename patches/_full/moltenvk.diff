+void mvkPassProbeOnPresent() {
+	MVKDebugBuffer::get().onPresent();
+	auto& pp = passProbe();
+	if ( !pp.enabled ) { return; }
+	std::lock_guard<std::mutex> guard(pp.lock);
+	double t = MVKPassProbe::now();
+	if ( !pp.firstPresent ) { pp.firstPresent = t; }
+	if (pp.active) {				// end of the captured frame
+		pp.active = false;
+		pp.closed = true;
+		if (pp.pending == 0 && !pp.written) { passProbeWriteLocked(pp); }
+		return;
+	}
+	// One frame every 20 s from 10 s on, up to kMaxDumps frames.
+	if ( !pp.written || pp.nextThreshold >= MVKPassProbe::kMaxDumps ) { return; }
+	if (t - pp.firstPresent >= 10.0 + 20.0 * pp.nextThreshold) {
+		pp.nextThreshold++;
+		pp.dumpIndex++;
+		pp.active = true;
+		pp.closed = false;
+		pp.written = false;
+		pp.used = 0;
+		pp.passCounter = 0;
+		pp.dispatchCounter = 0;
+		pp.records.clear();
+		pp.gapCS.clear();
+	}
+}
+
+void mvkPassProbeNoteCS(uint64_t shaderHash) {
+	auto& pp = passProbe();
+	if ( !pp.active ) { return; }
+	std::lock_guard<std::mutex> guard(pp.lock);
+	if (pp.active && pp.gapCS.size() < 64 && (pp.gapCS.empty() || pp.gapCS.back() != shaderHash)) { pp.gapCS.push_back(shaderHash); }
+}
+
+void mvkPassProbeNoteDispatch() {
+	auto& pp = passProbe();
+	if ( !pp.active ) { return; }
+	std::lock_guard<std::mutex> guard(pp.lock);
+	if (pp.active) { pp.dispatchCounter++; }
