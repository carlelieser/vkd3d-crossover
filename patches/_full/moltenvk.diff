+// Profiling aid: with MVK_PROFILE_SHADER_DIR set, write each compute and fragment shader's MSL once, named by the same code hash
+// that the GPU profiler ([mvk-gpuprof] "CS <hash>") prints. Unlike MVK_CONFIG_SHADER_DUMP_DIR it keeps the disk cache on.
+static void mvkProfileDumpComputeMSL(const SPIRVToMSLConversionConfiguration* cfg, size_t codeHash, const std::string& msl) {
+	static const char* dir = getenv("MVK_PROFILE_SHADER_DIR");
+	bool cs = cfg->options.entryPointStage == spv::ExecutionModelGLCompute, fs = cfg->options.entryPointStage == spv::ExecutionModelFragment;
+	if ( !dir || !*dir || !(cs || fs) || msl.empty() ) { return; }
+	char path[PATH_MAX];
+	mkdir(dir, 0755);
+	snprintf(path, sizeof(path), "%s/shader-%s-%016zx.metal", dir, cs ? "cs" : "fs", codeHash);
+	if (access(path, F_OK) == 0) { return; }
+	FILE* f = fopen(path, "wb");
+	if (f) { fwrite(msl.data(), 1, msl.size(), f); fclose(f); }
+}
+
+// Debugging aid: with MVK_MSL_OVERRIDE_DIR set, a file named like the profile dumps (shader-cs|fs-<hash>.metal) in that
+// directory replaces the converted MSL of that shader (used to instrument a single game shader). Never cached.
+// Debugging aid: MVK_SAFE_MATH_SHADERS=<hash>[,<hash>...] (code hashes as in the profile dumps) compiles those shaders
+// with MTLMathModeSafe and precise math functions. The converted MSL is tagged; newMTLLibrary reads the tag.
+static const char* kMVKSafeMathTag = "// MVK_SAFE_MATH\n";
+static void mvkApplySafeMathTag(size_t codeHash, std::string& msl) {
+	static const char* list = getenv("MVK_SAFE_MATH_SHADERS");
+	if ( !list || !*list || msl.compare(0, strlen(kMVKSafeMathTag), kMVKSafeMathTag) == 0 ) { return; }
+	char hex[24]; snprintf(hex, sizeof(hex), "%016zx", codeHash);
+	if (strcmp(list, "all") == 0 || strstr(list, hex)) { msl.insert(0, kMVKSafeMathTag); }
+}
+
+static void mvkApplyMSLOverride(const SPIRVToMSLConversionConfiguration* cfg, size_t codeHash, std::string& msl) {
+	static const char* dir = getenv("MVK_MSL_OVERRIDE_DIR");
+	if ( !dir || !*dir ) { return; }
+	bool cs = cfg->options.entryPointStage == spv::ExecutionModelGLCompute, fs = cfg->options.entryPointStage == spv::ExecutionModelFragment;
+	if ( !(cs || fs) ) { return; }
+	char path[PATH_MAX];
+	snprintf(path, sizeof(path), "%s/shader-%s-%016zx.metal", dir, cs ? "cs" : "fs", codeHash);
+	FILE* f = fopen(path, "rb");
+	if ( !f ) { return; }
+	std::string o; char buf[65536]; size_t n;
+	while ((n = fread(buf, 1, sizeof(buf), f)) > 0) { o.append(buf, n); }
+	fclose(f);
+	if ( !o.empty() ) { msl = o; mvkLogFailure("msl-override", "using %s", path); }
+}
