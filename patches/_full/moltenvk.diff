+// Failure log: report shaders that use the emulated 64-bit atomics (M1 has none in hardware). The emulation
+// works on the two 32-bit halves separately, so it can tear under contention; this shows how much a game relies on it.
+static void mvkLogAtomic64Use(SPIRVToMSLConversionConfiguration* pShaderConfig, const std::string& msl) {
+	if ( !mvkFailureLogEnabled() || msl.find("spvAtomic64") == std::string::npos ) { return; }
+	static const char* ops[] = { "Load", "Store", "Exchange", "CompareExchange", "Add", "And", "Or", "Xor",
+	                             "UMax", "UMin", "SMax", "SMin" };
+	std::string used;
+	size_t calls = 0;
+	for (const char* op : ops) {
+		std::string name = std::string("spvAtomic64") + op + "(";
+		size_t n = 0;
+		for (size_t pos = msl.find(name); pos != std::string::npos; pos = msl.find(name, pos + 1)) {
+			// Skip the helper definitions themselves ("inline ulong spvAtomic64X(" / "inline void spvAtomic64X(").
+			size_t ls = msl.rfind('\n', pos);
+			std::string head = msl.substr(ls == std::string::npos ? 0 : ls + 1, pos - (ls == std::string::npos ? 0 : ls + 1));
+			if (head.find("inline ") != std::string::npos) { continue; }
+			n++;
+		}
+		if (n) { used += (used.empty() ? "" : ", "); used += op; used += "x" + std::to_string(n); calls += n; }
+	}
+	if ( !calls ) { return; }
+	size_t tg = 0, dev = 0;
+	for (size_t pos = msl.find("(threadgroup atomic_uint*)"); pos != std::string::npos; pos = msl.find("(threadgroup atomic_uint*)", pos + 1)) { tg++; }
+	for (size_t pos = msl.find("(device atomic_uint*)"); pos != std::string::npos; pos = msl.find("(device atomic_uint*)", pos + 1)) { dev++; }
+	const char* stage = "?";
+	switch (pShaderConfig->options.entryPointStage) {
+		case spv::ExecutionModelVertex:    stage = "vertex"; break;
+		case spv::ExecutionModelFragment:  stage = "fragment"; break;
+		case spv::ExecutionModelGLCompute: stage = "compute"; break;
+		case spv::ExecutionModelMeshEXT:   stage = "mesh"; break;
+		case spv::ExecutionModelTaskEXT:   stage = "task"; break;
+		default: break;
+	}
+	mvkLogFailure("atomic64", "%s shader uses emulated 64-bit atomics: %s (buffer %s, threadgroup %s)",
+	              stage, used.c_str(), dev ? "yes" : "no", tg ? "yes" : "no");
+}
