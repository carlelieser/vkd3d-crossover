+MVKGPUProfileBatch* MVKCommandEncoder::profBatch() {
+	if ( !mvkGPUProfileEnabled() || !_mtlCmdBuffer ) { return nullptr; }
+	if (_profCmdBuffer == _mtlCmdBuffer && _profBatch) { return _profBatch.get(); }
+
+	static id<MTLCounterSet> tsSet = nil;
+	static bool supported = false;
+	static std::once_flag once;
+	id<MTLDevice> mtlDev = getMTLDevice();
+	std::call_once(once, [&]() {
+		if ( ![mtlDev supportsCounterSampling: MTLCounterSamplingPointAtStageBoundary] ) { return; }
+		for (id<MTLCounterSet> cs in mtlDev.counterSets) {
+			if ([cs.name isEqualToString: MTLCommonCounterSetTimestamp]) { tsSet = [cs retain]; supported = true; }
+		}
+	});
+	if ( !supported ) { return nullptr; }
+
+	auto batch = std::make_shared<MVKGPUProfileBatch>();
+	@autoreleasepool {
+		MTLCounterSampleBufferDescriptor* d = [[MTLCounterSampleBufferDescriptor new] autorelease];
+		d.counterSet = tsSet;
+		d.storageMode = MTLStorageModeShared;
+		d.sampleCount = kMVKGPUProfileSlots;
+		NSError* err = nil;
+		batch->sampleBuffer = [mtlDev newCounterSampleBufferWithDescriptor: d error: &err];
+	}
+	if ( !batch->sampleBuffer ) { return nullptr; }
+	std::shared_ptr<MVKGPUProfileBatch> keep = batch;
+	[_mtlCmdBuffer addCompletedHandler: ^(id<MTLCommandBuffer>) { mvkGPUProfileAccumulate(keep.get()); }];
+	_profBatch = batch;
+	_profCmdBuffer = _mtlCmdBuffer;
+	_profComputeSlot = -1;
+	return _profBatch.get();
+}
+
+int32_t MVKCommandEncoder::profAllocSlot(const std::string& key) {
+	auto* batch = profBatch();
+	if ( !batch || batch->next + 2 > kMVKGPUProfileSlots ) { return -1; }
+	int32_t slot = (int32_t)batch->next;
+	batch->next += 2;
+	batch->keys.push_back(key);
+	return slot;
+}
