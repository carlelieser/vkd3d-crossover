+#pragma mark -
+#pragma mark MVKCmdDrawMeshTasks
+
+VkResult MVKCmdDrawMeshTasks::setContent(MVKCommandBuffer* cmdBuff, uint32_t groupCountX, uint32_t groupCountY, uint32_t groupCountZ) {
+	_groupCount[0] = groupCountX;
+	_groupCount[1] = groupCountY;
+	_groupCount[2] = groupCountZ;
+	return VK_SUCCESS;
+}
+
+// Common preamble for mesh draws. Returns the pipeline if drawing can proceed, or nullptr.
+static MVKGraphicsPipeline* prepareMeshDraw(MVKCommandEncoder* cmdEncoder) {
+	cmdEncoder->restartMetalRenderPassIfNeeded();
+	auto* pipeline = cmdEncoder->getGraphicsPipeline();
+	if ( !pipeline || !pipeline->isMeshPipeline() ) { return nullptr; }
+	cmdEncoder->_isIndexedDraw = false;
+	cmdEncoder->finalizeDrawState(kMVKGraphicsStageRasterization);	// Ensure all updated state has been submitted to Metal
+	if ( !pipeline->hasValidMTLPipelineStates() ) { mvkLogFailure("draw-skipped", "mesh draw skipped: its pipeline failed to compile"); return nullptr; }
+	return pipeline;
+}
+
+void MVKCmdDrawMeshTasks::encode(MVKCommandEncoder* cmdEncoder) {
+	cmdEncoder->notePassProbeDraw(5);
+	if (_groupCount[0] == 0 || _groupCount[1] == 0 || _groupCount[2] == 0) { return; }	// Nothing to do.
+	auto* pipeline = prepareMeshDraw(cmdEncoder);
+	if ( !pipeline ) { return; }
+	if (@available(macOS 13.0, iOS 16.0, tvOS 16.0, *)) {
+		// Without a task shader, the Vulkan group counts are the mesh grid directly; Metal treats
+		// threadgroupsPerGrid the same way when the pipeline has no object function.
+		[cmdEncoder->_mtlRenderEncoder drawMeshThreadgroups: MTLSizeMake(_groupCount[0], _groupCount[1], _groupCount[2])
+		                         threadsPerObjectThreadgroup: pipeline->getTaskThreadgroupSize()
+		                           threadsPerMeshThreadgroup: pipeline->getMeshThreadgroupSize()];
+	}
+}
+
+
+#pragma mark -
+#pragma mark MVKCmdDrawMeshTasksIndirect
+
+VkResult MVKCmdDrawMeshTasksIndirect::setContent(MVKCommandBuffer* cmdBuff, VkBuffer buffer, VkDeviceSize offset,
+                                                 uint32_t drawCount, uint32_t stride) {
+	MVKBuffer* mvkBuffer = (MVKBuffer*)buffer;
+	_mtlIndirectBuffer = mvkBuffer->getMTLBuffer();
+	_mtlIndirectBufferOffset = mvkBuffer->getMTLBufferOffset() + offset;
+	_mtlCountBuffer = nil;
+	_mtlCountBufferOffset = 0;
+	_drawCount = drawCount;
+	_stride = stride ? stride : sizeof(VkDrawMeshTasksIndirectCommandEXT);
+	return VK_SUCCESS;
+}
+
+VkResult MVKCmdDrawMeshTasksIndirect::setContent(MVKCommandBuffer* cmdBuff, VkBuffer buffer, VkDeviceSize offset,
+                                                 VkBuffer countBuffer, VkDeviceSize countBufferOffset,
+                                                 uint32_t maxDrawCount, uint32_t stride) {
+	setContent(cmdBuff, buffer, offset, maxDrawCount, stride);
+	MVKBuffer* mvkCountBuffer = (MVKBuffer*)countBuffer;
+	_mtlCountBuffer = mvkCountBuffer->getMTLBuffer();
+	_mtlCountBufferOffset = mvkCountBuffer->getMTLBufferOffset() + countBufferOffset;
+	return VK_SUCCESS;
+}
+
+void MVKCmdDrawMeshTasksIndirect::encode(MVKCommandEncoder* cmdEncoder) {
+	cmdEncoder->notePassProbeDraw(6);
+	if (_drawCount == 0) { return; }
+
+	id<MTLBuffer> argBuffer = _mtlIndirectBuffer;
+	VkDeviceSize argOffset = _mtlIndirectBufferOffset;
+	VkDeviceSize argStride = _stride;
+	if (_mtlCountBuffer) {
+		// Reuse the non-indexed indirect-count conversion kernel: it copies 16-byte records and zeroes the
+		// second word (instanceCount, i.e. groupCountY here) for draws past the GPU-side count.
+		// VkDrawMeshTasksIndirectCommandEXT {x,y,z} occupies the first 12 bytes of each 16-byte record.
+		// NOTE: with a 12-byte source stride the last record reads 4 bytes past the final command.
+		cmdEncoder->restartMetalRenderPassIfNeeded();
+		auto* converted = encodeIndirectCountConversion(cmdEncoder, _mtlIndirectBuffer, _mtlIndirectBufferOffset, _stride,
+		                                                _mtlCountBuffer, _mtlCountBufferOffset, _drawCount, false);
+		argBuffer = converted->_mtlBuffer;
+		argOffset = converted->_offset;
+		argStride = sizeof(MTLDrawPrimitivesIndirectArguments);
+	}
+
+	auto* pipeline = prepareMeshDraw(cmdEncoder);
+	if ( !pipeline ) { return; }
+	if (@available(macOS 13.0, iOS 16.0, tvOS 16.0, *)) {
+		for (uint32_t i = 0; i < _drawCount; i++) {
+			[cmdEncoder->_mtlRenderEncoder drawMeshThreadgroupsWithIndirectBuffer: argBuffer
+			                                                 indirectBufferOffset: argOffset + i * argStride
+			                                          threadsPerObjectThreadgroup: pipeline->getTaskThreadgroupSize()
+			                                            threadsPerMeshThreadgroup: pipeline->getMeshThreadgroupSize()];
+		}
+	}
+}
