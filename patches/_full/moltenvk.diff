+	if ( !_presentProbe ) { _presentProbe = std::make_shared<MVKPresentProbe>(); }
+	auto probe = _presentProbe;
+	if ((probe->presentCount++ % 30) != 0) { return; }
+
+	if (mtlTexture.framebufferOnly) {
+		if ( !probe->unavailableLogged ) {
