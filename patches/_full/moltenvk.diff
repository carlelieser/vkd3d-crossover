+	id<MTLBuffer> buf = probe->buffer;
+	[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer> mcb) {
+		if (mcb.status != MTLCommandBufferStatusCompleted) { return; }
+		const uint8_t* d = (const uint8_t*)buf.contents;
+		bool black = true;
+		for (uint32_t k = 0; k < 16 && black; k++) {
+			if (kind == 2) {
+				uint16_t c[4]; memcpy(c, d + k * 8, 8);
+				black = !((c[0] | c[1] | c[2]) & 0x7FFF);
+			} else {
+				uint32_t px; memcpy(&px, d + k * 4, 4);
