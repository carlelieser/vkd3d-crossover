From 547373b2be83ffc05349996a2e6206e8c080150a Mon Sep 17 00:00:00 2001
From: vkd3d-crossover <noreply@vkd3d-crossover.invalid>
Date: Tue, 17 Nov 2026 01:00:16 -0500
Subject: [PATCH] LegacyF32ToF16: exact round-toward-zero
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Problem: packed fp16 values became +-Inf where D3D gives +-65504. In RE Engine
the hair-strand colour (packed fp16, then R11G11B10) turned Inf and bloom/TAA
spread it into blown-out highlights.

Root cause: D3D defines f32tof16 as round-toward-zero (overflow saturates to the
largest finite half). dxil-spirv emits GLSL.std.450 PackHalf2x16, which rounds to
nearest on most non-AMD implementations, Metal included, so overflow gives Inf.
(The existing comment already notes RTZ is required.)

Fix: pack, unpack, and if the rounded magnitude exceeds the input's, step the
packed magnitude back by one ulp (packed - 1; sign is bit 15). Exact RTZ; NaN and
Inf inputs are unchanged (the comparison is false).

Verified by: vkd3d-proton test_fp16_rounding_behavior (sm62 + legacy, ~16.7M
cases), test_shader_instructions (5347), sm69_long_vector_intrinsics: 0 failures.
In-game: Inf values gone from the hair resolve (NOTES.md §34).

Off switch: DXIL_SPIRV_F16_RTE=1 restores plain packHalf2x16.
---
 opcodes/dxil/dxil_arithmetic.cpp | 76 +++++++++++++++++++++++++++++---
 1 file changed, 69 insertions(+), 7 deletions(-)

diff --git a/opcodes/dxil/dxil_arithmetic.cpp b/opcodes/dxil/dxil_arithmetic.cpp
index 7032448..35db8f9 100644
--- a/opcodes/dxil/dxil_arithmetic.cpp
+++ b/opcodes/dxil/dxil_arithmetic.cpp
@@ -1199,15 +1199,77 @@ bool emit_legacy_f32_to_f16_instruction(Converter::Impl &impl, const llvm::CallI
 		input_id = quant_op->id;
 	}
 
-	Operation *op = impl.allocate(spv::OpExtInst, instruction);
-	op->add_id(impl.glsl_std450_ext);
-	op->add_literal(GLSLstd450PackHalf2x16);
-
-	if (impl.shader_analysis.precise_f16_to_f32_observed && impl.execution_mode_meta.float_controls2)
-		add_nocontract_decoration(impl, op->id);
+	// Round-toward-zero, exactly: packHalf2x16 rounds to nearest on most non-AMD implementations (Metal included),
+	// so out-of-range values become +-Inf where D3D gives +-65504 (e.g. RE Engine's hair-strand radiance packed to
+	// fp16 then R11G11B10: Inf there turns into blown-out hair). The RTE result is either the RTZ result or one ulp
+	// further from zero; unpack it, and if its magnitude exceeds the input's, step the magnitude back by one ulp
+	// (the sign is bit 15, the magnitude the low 15 bits, so that is packed - 1). NaN and Inf inputs are unchanged
+	// (the comparison is false). DXIL_SPIRV_F16_RTE=1 restores the plain packHalf2x16.
+	static const bool plain_rte = [] { const char *e = getenv("DXIL_SPIRV_F16_RTE"); return e && e[0] == '1'; }();
 
 	spv::Id inputs[2] = { input_id, builder.makeFloatConstant(0.0f) };
-	op->add_id(impl.build_vector(builder.makeFloatType(32), inputs, 2));
+	spv::Id packed_input = impl.build_vector(builder.makeFloatType(32), inputs, 2);
+
+	if (plain_rte)
+	{
+		Operation *op = impl.allocate(spv::OpExtInst, instruction);
+		op->add_id(impl.glsl_std450_ext);
+		op->add_literal(GLSLstd450PackHalf2x16);
+		if (impl.shader_analysis.precise_f16_to_f32_observed && impl.execution_mode_meta.float_controls2)
+			add_nocontract_decoration(impl, op->id);
+		op->add_id(packed_input);
+		impl.add(op);
+		impl.decorate_relaxed_precision(instruction->getType(), op->id, false);
+		return true;
+	}
+
+	spv::Id uint_type = builder.makeUintType(32);
+	spv::Id float_type = builder.makeFloatType(32);
+
+	Operation *pack_op = impl.allocate(spv::OpExtInst, uint_type);
+	pack_op->add_id(impl.glsl_std450_ext);
+	pack_op->add_literal(GLSLstd450PackHalf2x16);
+	pack_op->add_id(packed_input);
+	impl.add(pack_op);
+	add_nocontract_decoration(impl, pack_op->id);
+
+	Operation *unpack_op = impl.allocate(spv::OpExtInst, builder.makeVectorType(float_type, 2));
+	unpack_op->add_id(impl.glsl_std450_ext);
+	unpack_op->add_literal(GLSLstd450UnpackHalf2x16);
+	unpack_op->add_id(pack_op->id);
+	impl.add(unpack_op);
+
+	Operation *rounded = impl.allocate(spv::OpCompositeExtract, float_type);
+	rounded->add_id(unpack_op->id);
+	rounded->add_literal(0);
+	impl.add(rounded);
+
+	Operation *abs_rounded = impl.allocate(spv::OpExtInst, float_type);
+	abs_rounded->add_id(impl.glsl_std450_ext);
+	abs_rounded->add_literal(GLSLstd450FAbs);
+	abs_rounded->add_id(rounded->id);
+	impl.add(abs_rounded);
+
+	Operation *abs_input = impl.allocate(spv::OpExtInst, float_type);
+	abs_input->add_id(impl.glsl_std450_ext);
+	abs_input->add_literal(GLSLstd450FAbs);
+	abs_input->add_id(input_id);
+	impl.add(abs_input);
+
+	Operation *away = impl.allocate(spv::OpFOrdGreaterThan, builder.makeBoolType());
+	away->add_id(abs_rounded->id);
+	away->add_id(abs_input->id);
+	impl.add(away);
+
+	Operation *stepped = impl.allocate(spv::OpISub, uint_type);
+	stepped->add_id(pack_op->id);
+	stepped->add_id(builder.makeUintConstant(1));
+	impl.add(stepped);
+
+	Operation *op = impl.allocate(spv::OpSelect, instruction);
+	op->add_id(away->id);
+	op->add_id(stepped->id);
+	op->add_id(pack_op->id);
 	impl.add(op);
 	impl.decorate_relaxed_precision(instruction->getType(), op->id, false);
 
-- 
2.51.0

