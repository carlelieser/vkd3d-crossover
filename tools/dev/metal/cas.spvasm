      %entry = OpLabel
         %id = OpLoad %uint %gid
          %p = OpAccessChain %ptr_wg_u %shared %uint_0
        %old = OpLoad %uint %p
        %new = OpIAdd %uint %old %id
       %orig = OpAtomicCompareExchange %uint %p %uint_2 %uint_0 %uint_0 %new %old
         %ok = OpIEqual %bool %orig %old
         %ou = OpSelect %uint %ok %uint_1 %uint_0
          %q = OpAccessChain %ptr_sb_u %outbuf %uint_0 %id
               OpStore %q %ou
               OpReturn
               OpFunctionEnd
